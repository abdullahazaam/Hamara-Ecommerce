@model HamaraCommerce.Models.Order
@inject HamaraCommerce.Services.IShippingTaxService ShippingTaxService
@{
    ViewData["Title"] = "Order Confirmed — #" + Model.OrderNumber;
}

<div class="row justify-content-center py-4 reveal-on-scroll">
    <div class="col-lg-8">
        <!-- Success Banner -->
        <div class="card-glass rounded-4 p-4 p-md-5 text-center mb-4"
             style="background:var(--bg-glass); backdrop-filter:blur(24px); border:1px solid var(--border-default) !important; box-shadow:var(--shadow-lg);">
            
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 p-3"
                 style="width: 80px; height: 80px; background: rgba(16,185,129,0.15); color: #10b981; box-shadow: 0 0 30px rgba(16,185,129,0.25);">
                <i class="fa-solid fa-circle-check fa-2x"></i>
            </div>

            <h1 class="h2 font-heading fw-bold mb-2" style="color:var(--text-primary); letter-spacing:-0.02em;">Order Confirmed!</h1>
            <p class="small mb-4" style="color:var(--text-muted); max-width:480px; margin-left:auto; margin-right:auto;">
                Thank you for your order, <strong>@Model.CustomerName</strong>. We have dispatched a confirmation receipt to <strong>@Model.CustomerEmail</strong>.
            </p>

            <!-- Order Reference Cards -->
            <div class="row g-3 p-3.5 rounded-4 text-start small mb-4"
                 style="background:var(--bg-surface-elevated); border:1px solid var(--border-subtle);">
                <div class="col-sm-6">
                    <span class="d-block" style="color:var(--text-muted);">Order Reference:</span>
                    <strong class="font-monospace fs-6" style="color:var(--brand-primary);">@Model.OrderNumber</strong>
                </div>
                <div class="col-sm-6">
                    <span class="d-block" style="color:var(--text-muted);">Tracking Number:</span>
                    <strong class="font-monospace fs-6" style="color:var(--text-primary);">@Model.TrackingNumber</strong>
                </div>
                <div class="col-sm-6">
                    <span class="d-block" style="color:var(--text-muted);">Payment Method:</span>
                    <span class="fw-semibold" style="color:var(--text-primary);">@Model.PaymentMethod</span>
                </div>
                <div class="col-sm-6">
                    <span class="d-block" style="color:var(--text-muted);">Estimated Dispatch:</span>
                    <span class="fw-semibold" style="color:var(--text-primary);"><i class="fa-solid fa-bolt text-warning me-1"></i>Within 24-48 Hours</span>
                </div>
            </div>

            <!-- Purchased Items -->
            <div class="text-start mb-4">
                <h2 class="h6 font-heading fw-bold mb-3" style="color:var(--text-primary);">Purchased Items</h2>
                <div class="d-flex flex-column gap-2">
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex align-items-center justify-content-between p-2.5 rounded-3 border"
                             style="background:var(--bg-surface); border-color:var(--border-default) !important;">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@item.ProductImage" class="rounded-2 border" style="width: 48px; height: 48px; object-fit: cover; border-color:var(--border-default) !important;" alt="@item.ProductTitle" />
                                <div>
                                    <strong class="d-block small" style="color:var(--text-primary);">@item.ProductTitle</strong>
                                    <span class="text-xs" style="color:var(--text-muted);">Qty: @item.Quantity &times; @ShippingTaxService.FormatCurrency(item.UnitPrice)</span>
                                </div>
                            </div>
                            <span class="small fw-bold" style="color:var(--text-primary);">@ShippingTaxService.FormatCurrency(item.TotalPrice)</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Financial Breakdown -->
            <div class="text-start border-top pt-3 mb-4 small" style="border-color:var(--border-subtle) !important;">
                <div class="d-flex justify-content-between mb-1" style="color:var(--text-muted);">
                    <span>Subtotal:</span>
                    <span style="color:var(--text-primary);">@ShippingTaxService.FormatCurrency(Model.Subtotal)</span>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-1 fw-bold" style="color:var(--status-success);">
                        <span>Discount:</span>
                        <span>-@ShippingTaxService.FormatCurrency(Model.DiscountAmount)</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-1" style="color:var(--text-muted);">
                    <span>GST Tax:</span>
                    <span style="color:var(--text-primary);">@ShippingTaxService.FormatCurrency(Model.TaxAmount)</span>
                </div>
                <div class="d-flex justify-content-between mb-2" style="color:var(--text-muted);">
                    <span>Shipping Fee:</span>
                    <span style="color:var(--text-primary);">@(Model.ShippingFee == 0 ? "FREE" : ShippingTaxService.FormatCurrency(Model.ShippingFee))</span>
                </div>
                <hr style="border-color:var(--border-subtle) !important;" />
                <div class="d-flex justify-content-between fs-5 fw-bold" style="color:var(--text-primary);">
                    <span>Total Amount:</span>
                    <span class="font-heading" style="color:var(--brand-primary);">@ShippingTaxService.FormatCurrency(Model.TotalAmount)</span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a asp-controller="OrderTracking" asp-action="Index" asp-route-trackingNumber="@Model.TrackingNumber" asp-route-email="@Model.CustomerEmail" asp-route-guestToken="@Model.GuestAccessToken" class="btn btn-primary-custom px-4 rounded-pill">
                    <i class="fa-solid fa-location-dot me-1"></i>Track Shipment
                </a>
                <a asp-controller="Account" asp-action="Invoice" asp-route-id="@Model.OrderNumber" asp-route-guestToken="@Model.GuestAccessToken" class="btn btn-outline-secondary px-4 rounded-pill" target="_blank">
                    <i class="fa-solid fa-print me-1"></i>Print Invoice
                </a>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-glass px-4 rounded-pill">
                    <i class="fa-solid fa-bag-shopping me-1"></i>Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>
