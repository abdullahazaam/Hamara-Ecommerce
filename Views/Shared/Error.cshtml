@model ErrorViewModel
@{
    ViewData["Title"] = "System Error — Hamara Commerce";
}

<div class="row justify-content-center py-5 reveal-on-scroll">
    <div class="col-md-7 col-lg-6 text-center">
        <div class="card-glass rounded-4 p-4 p-md-5 position-relative overflow-hidden"
             style="background:var(--bg-glass); backdrop-filter:blur(24px); border:1px solid var(--border-default) !important; box-shadow:var(--shadow-xl);">
            
            <div class="rounded-circle d-inline-flex mx-auto mb-3 p-3"
                 style="width: 72px; height: 72px; background: rgba(239,68,68,0.15); color: #ef4444; align-items: center; justify-content: center; box-shadow:0 0 25px rgba(239,68,68,0.20);">
                <i class="fa-solid fa-triangle-exclamation fs-2"></i>
            </div>

            <h1 class="h3 font-heading fw-bold mb-2" style="color:var(--text-primary); letter-spacing:-0.02em;">An Unexpected Error Occurred</h1>
            <p class="small mb-4" style="color:var(--text-muted); line-height:1.7;">
                Our technical support team has logged this occurrence. Please try returning to the home catalog or checking back shortly.
            </p>

            @if (Model?.ShowRequestId == true)
            {
                <div class="p-2.5 rounded-3 mb-4 font-monospace text-xs" style="background:var(--bg-surface-elevated); color:var(--text-muted); border:1px solid var(--border-subtle);">
                    <strong>Diagnostic Reference:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom rounded-pill px-4">
                    <i class="fa-solid fa-house me-1"></i>Back to Home
                </a>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-glass rounded-pill px-4">
                    <i class="fa-solid fa-bag-shopping me-1"></i>Explore Catalog
                </a>
            </div>
        </div>
    </div>
</div>
