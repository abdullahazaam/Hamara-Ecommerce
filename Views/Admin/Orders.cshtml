@model HamaraCommerce.Models.AdminOrderListViewModel
@inject HamaraCommerce.Services.IShippingTaxService ShippingTaxService
@{
    ViewData["Title"] = "Order Operations";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 font-heading fw-bold mb-1">Order Fulfillment & Management</h2>
        <p class="text-muted small mb-0">Search, filter, update shipment tracking, and process order lifecycle transitions.</p>
    </div>
    <a asp-controller="Admin" asp-action="ExportOrdersCsv" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="fa-solid fa-file-csv me-1"></i>Export Orders CSV
    </a>
</div>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-card">
    <form asp-controller="Admin" asp-action="Orders" method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="search" class="form-control border-0 bg-light" placeholder="Search by Order #, Tracking #, Customer Name, or Email..." value="@Model.SearchTerm" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select border-0 bg-light" asp-for="StatusFilter" asp-items="Html.GetEnumSelectList<OrderStatus>()">
                <option value="">-- All Order Statuses --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="paymentStatus" class="form-select border-0 bg-light" asp-for="PaymentStatusFilter" asp-items="Html.GetEnumSelectList<PaymentStatus>()">
                <option value="">-- All Payment Statuses --</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary-custom w-100 rounded-3">Filter</button>
        </div>
    </form>
</div>

<!-- Orders Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-card mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Order Ref</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th class="pe-4 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-box-open fs-2 d-block mb-2 opacity-50"></i>
                            No orders found matching the filter criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@o.Id" class="fw-bold text-primary font-monospace text-decoration-none">
                                    @o.OrderNumber
                                </a>
                                <span class="small text-muted d-block font-monospace">@o.TrackingNumber</span>
                            </td>
                            <td class="small text-muted">@o.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <strong class="small text-dark d-block">@o.CustomerName</strong>
                                <span class="small text-muted">@o.CustomerEmail</span>
                            </td>
                            <td class="small">@o.Items.Sum(i => i.Quantity) items</td>
                            <td>
                                <span class="badge @(o.PaymentStatus == PaymentStatus.Paid ? "bg-success" : "bg-warning text-dark") rounded-pill px-2.5 py-1 small">
                                    @o.PaymentStatus
                                </span>
                                <span class="text-muted text-xs d-block">@o.PaymentMethod</span>
                            </td>
                            <td>
                                @{
                                    var badgeClass = o.Status switch
                                    {
                                        OrderStatus.Delivered => "bg-success",
                                        OrderStatus.OutForDelivery => "bg-warning text-dark",
                                        OrderStatus.Shipped => "bg-info text-dark",
                                        OrderStatus.Packed => "bg-primary",
                                        OrderStatus.Confirmed => "bg-primary-subtle text-primary border border-primary",
                                        OrderStatus.Cancelled => "bg-danger",
                                        OrderStatus.Refunded => "bg-secondary text-white",
                                        _ => "bg-secondary text-white"
                                    };
                                }
                                <span class="badge @badgeClass rounded-pill px-2.5 py-1 small">@o.Status</span>
                            </td>
                            <td class="fw-bold text-dark">@ShippingTaxService.FormatCurrency(o.TotalAmount)</td>
                            <td class="pe-4 text-end">
                                <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@o.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1">
                                    Manage
                                </a>
                                <a asp-controller="Admin" asp-action="Invoice" asp-route-id="@o.Id" class="btn btn-glass btn-sm rounded-circle p-2" title="Print Invoice" target="_blank">
                                    <i class="fa-solid fa-print"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Bounded Pagination -->
@await Html.PartialAsync("_AdminPagination", new AdminPaginationViewModel
{
    CurrentPage = Model.CurrentPage,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize,
    Action = "Orders",
    Controller = "Admin"
})
