@model List<HamaraCommerce.Models.Product>
@inject HamaraCommerce.Services.IShippingTaxService ShippingTaxService
@{
    ViewData["Title"] = "Product Catalog";
    Layout = "_AdminLayout";
    var categories = ViewBag.Categories as List<HamaraCommerce.Models.Category> ?? new();
    var currentStatus = ViewBag.StatusFilter as HamaraCommerce.Models.ProductStatus?;
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : Model.Count;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="h4 font-heading fw-bold mb-1">Product Catalog & Inventory</h2>
        <p class="text-muted small mb-0">Total @totalCount products in catalog (manage variants, images, stock, and pricing)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Admin" asp-action="ExportProductsCsv" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-file-csv me-1"></i>Export Catalog CSV
        </a>
        <a asp-controller="Admin" asp-action="AddProduct" class="btn btn-primary-custom px-4 rounded-pill">
            <i class="fa-solid fa-plus me-1"></i>Add New Product
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-card mb-4">
    <!-- FILTER BAR -->
    <form asp-controller="Admin" asp-action="Products" method="get" class="row g-3 mb-4">
        <div class="col-md-5">
            <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control rounded-3" placeholder="Search by title, SKU, brand..." />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select rounded-3">
                <option value="">All Categories</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id" selected="@(ViewBag.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select rounded-3">
                <option value="">All Statuses</option>
                <option value="Published" selected="@(currentStatus == HamaraCommerce.Models.ProductStatus.Published)">Published</option>
                <option value="Draft" selected="@(currentStatus == HamaraCommerce.Models.ProductStatus.Draft)">Draft</option>
                <option value="Archived" selected="@(currentStatus == HamaraCommerce.Models.ProductStatus.Archived)">Archived</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary-custom w-100 rounded-3">
                <i class="fa-solid fa-filter me-1"></i>Filter
            </button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-3">Product</th>
                    <th>SKU & Slug</th>
                    <th>Category</th>
                    <th>Price / Cost</th>
                    <th>Status</th>
                    <th>Stock</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-box-open fs-2 mb-2 d-block opacity-50"></i>
                            No products found matching the criteria.
                        </td>
                    </tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="ps-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@p.MainImage" class="rounded-3 border" style="width:48px; height:48px; object-fit:cover;" alt="@p.Title" loading="lazy" />
                                <div>
                                    <div class="fw-bold text-dark text-truncate" style="max-width:240px;">@p.Title</div>
                                    <div class="small text-muted">
                                        <span>@p.Brand</span>
                                        @if (p.Variants.Any())
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary ms-1">@p.Variants.Count variants</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="font-monospace small fw-semibold">@p.SKU</div>
                            <div class="small text-muted font-monospace">/@p.Slug</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@p.CategoryName</span></td>
                        <td>
                            <div class="fw-bold text-primary">@ShippingTaxService.FormatCurrency(p.Price)</div>
                            @if (p.CostPrice > 0)
                            {
                                <div class="small text-muted">Cost: @ShippingTaxService.FormatCurrency(p.CostPrice)</div>
                            }
                        </td>
                        <td>
                            @{
                                var statusClass = p.Status switch
                                {
                                    HamaraCommerce.Models.ProductStatus.Published => "bg-success-subtle text-success border border-success",
                                    HamaraCommerce.Models.ProductStatus.Draft => "bg-warning-subtle text-warning-emphasis border border-warning",
                                    HamaraCommerce.Models.ProductStatus.Archived => "bg-secondary-subtle text-secondary border border-secondary",
                                    _ => "bg-light text-dark"
                                };
                            }
                            <span class="badge @statusClass rounded-pill px-2.5 py-1">@p.Status</span>
                        </td>
                        <td>
                            @if (p.Stock > 10)
                            {
                                <span class="badge bg-success rounded-pill px-2.5 py-1">@p.Stock in stock</span>
                            }
                            else if (p.Stock > 0)
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1">@p.Stock Low Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-pill px-2.5 py-1">Out of Stock</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group">
                                <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm" title="Edit Product">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id" target="_blank" class="btn btn-outline-secondary btn-sm" title="View Storefront">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>
                                <form asp-controller="Admin" asp-action="ArchiveProduct" method="post" class="d-inline" onsubmit="return confirm('Archive this product?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Archive Product">
                                        <i class="fa-solid fa-box-archive"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Bounded Pagination -->
@await Html.PartialAsync("_AdminPagination", new AdminPaginationViewModel
{
    CurrentPage = currentPage,
    TotalPages = totalPages,
    TotalCount = totalCount,
    PageSize = ViewBag.PageSize ?? 10,
    Action = "Products",
    Controller = "Admin"
})
