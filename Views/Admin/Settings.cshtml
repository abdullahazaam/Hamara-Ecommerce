@model HamaraCommerce.Models.StoreSetting
@{
    ViewData["Title"] = "Store Operational Settings";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 font-heading fw-bold mb-1">Store Operational Settings</h2>
        <p class="text-muted small mb-0">Configure persistent marketplace parameters, tax rules, courier fees, and contact details.</p>
    </div>
    <span class="small text-muted">Last Modified: @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm") UTC</span>
</div>

<form asp-controller="Admin" asp-action="Settings" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-4">
        <!-- Store Identity & Contact -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-card h-100">
                <h5 class="fw-bold font-heading mb-3 text-primary">
                    <i class="fa-solid fa-store me-2"></i>Marketplace Identity & Contact
                </h5>

                <div class="mb-3">
                    <label asp-for="StoreName" class="form-label small fw-bold text-muted"></label>
                    <input asp-for="StoreName" class="form-control" required />
                    <span asp-validation-for="StoreName" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StoreEmail" class="form-label small fw-bold text-muted"></label>
                        <input asp-for="StoreEmail" class="form-control" required />
                        <span asp-validation-for="StoreEmail" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StorePhone" class="form-label small fw-bold text-muted"></label>
                        <input asp-for="StorePhone" class="form-control" required />
                        <span asp-validation-for="StorePhone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="StoreAddress" class="form-label small fw-bold text-muted"></label>
                    <textarea asp-for="StoreAddress" class="form-control" rows="3" required></textarea>
                    <span asp-validation-for="StoreAddress" class="text-danger small"></span>
                </div>

                <div class="form-check mt-3">
                    <input asp-for="EnableGuestCheckout" class="form-check-input" />
                    <label asp-for="EnableGuestCheckout" class="form-check-label small fw-semibold text-dark"></label>
                </div>
            </div>
        </div>

        <!-- Financial, Tax & Shipping Rules -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-card h-100">
                <h5 class="fw-bold font-heading mb-3 text-primary">
                    <i class="fa-solid fa-coins me-2"></i>Financial & Logistics Parameters
                </h5>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CurrencyCode" class="form-label small fw-bold text-muted"></label>
                        <input asp-for="CurrencyCode" class="form-control font-monospace" required />
                        <span asp-validation-for="CurrencyCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CurrencySymbol" class="form-label small fw-bold text-muted"></label>
                        <input asp-for="CurrencySymbol" class="form-control font-monospace" required />
                        <span asp-validation-for="CurrencySymbol" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="TaxRatePercent" class="form-label small fw-bold text-muted"></label>
                        <div class="input-group">
                            <input asp-for="TaxRatePercent" class="form-control" type="number" step="0.1" required />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="TaxRatePercent" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LowStockThreshold" class="form-label small fw-bold text-muted"></label>
                        <input asp-for="LowStockThreshold" class="form-control" type="number" min="1" required />
                        <span asp-validation-for="LowStockThreshold" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="FreeShippingThreshold" class="form-label small fw-bold text-muted"></label>
                    <input asp-for="FreeShippingThreshold" class="form-control" type="number" step="10" required />
                    <span asp-validation-for="FreeShippingThreshold" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StandardShippingFee" class="form-label small fw-bold text-muted"></label>
                        <input asp-for="StandardShippingFee" class="form-control" type="number" step="10" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ExpressShippingFee" class="form-label small fw-bold text-muted"></label>
                        <input asp-for="ExpressShippingFee" class="form-control" type="number" step="10" required />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 text-end">
            <button type="submit" class="btn btn-primary-custom px-5 py-2.5 rounded-pill fw-bold">
                <i class="fa-solid fa-floppy-disk me-2"></i>Save Store Settings
            </button>
        </div>
    </div>
</form>
