@model HamaraCommerce.Models.AdminReturnsViewModel
@{
    ViewData["Title"] = "Returns & Refunds";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 font-heading fw-bold mb-1">Returns &amp; Refunds Governance</h2>
        <p class="text-muted small mb-0">Audit customer return requests, execute condition inspection, issue verified refunds, and control inventory restocking.</p>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-card">
    <form asp-controller="Admin" asp-action="Returns" method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="status" class="form-select rounded-pill">
                <option value="">All Return Requests</option>
                <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending Decision</option>
                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed / Refunded</option>
                <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">Declined / Rejected</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary-custom w-100 rounded-pill">
                <i class="fa-solid fa-filter me-1"></i>Filter
            </button>
        </div>
        @if (!string.IsNullOrEmpty(Model.StatusFilter))
        {
            <div class="col-md-2">
                <a asp-controller="Admin" asp-action="Returns" class="btn btn-outline-secondary w-100 rounded-pill">Reset</a>
            </div>
        }
    </form>
</div>

<!-- Returns Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-card">
    @if (!Model.ReturnOrders.Any())
    {
        <div class="text-center py-5">
            <i class="fa-solid fa-box-archive fs-1 text-muted mb-3 d-block"></i>
            <h5 class="fw-semibold">No return requests found</h5>
            <p class="text-muted small mb-0">No customer returns match the current filter selection.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="small text-muted text-uppercase">
                        <th class="ps-4">Order Ref</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Requested Date</th>
                        <th>Return Reason</th>
                        <th>Inspection &amp; Refund Status</th>
                        <th>Refund Amount</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.ReturnOrders)
                    {
                        <tr>
                            <td class="ps-4 font-monospace fw-bold">
                                <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@o.Id" class="text-decoration-none">
                                    #@o.OrderNumber
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold">@o.CustomerName</div>
                                <div class="small text-muted">@o.CustomerEmail</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border">@o.Items.Count items</span>
                            </td>
                            <td class="small">
                                @(o.ReturnRequestedAt?.ToString("MMM dd, yyyy HH:mm") ?? o.OrderDate.ToString("MMM dd, yyyy"))
                            </td>
                            <td class="small text-muted" style="max-width:220px;">
                                @(string.IsNullOrWhiteSpace(o.ReturnReason) ? "Not specified" : o.ReturnReason)
                            </td>
                            <td>
                                @if (o.RefundStatus == "Completed")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success mb-1">Refund Completed</span>
                                    <div class="small text-muted">Ref: @o.RefundTransactionReference</div>
                                }
                                else if (o.RefundStatus == "Rejected")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">Declined</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning">Pending Review</span>
                                }
                                @if (!string.IsNullOrEmpty(o.ReturnInspectionState))
                                {
                                    <div class="small text-secondary">@o.ReturnInspectionState</div>
                                }
                                @if (o.IsRestockedOnReturn)
                                {
                                    <span class="badge bg-info-subtle text-info border small mt-1">Items Restocked</span>
                                }
                            </td>
                            <td class="fw-bold">
                                @if (o.RefundAmount.HasValue)
                                {
                                    <span>Rs. @o.RefundAmount.Value.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">Rs. @o.TotalAmount.ToString("N2")</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 btn-process-return"
                                        data-order-id="@o.Id"
                                        data-order-number="@o.OrderNumber"
                                        data-total-amount="@o.TotalAmount"
                                        data-payment-method="@o.PaymentMethod"
                                        data-return-reason="@o.ReturnReason"
                                        data-inspection-state="@o.ReturnInspectionState"
                                        data-is-restocked="@o.IsRestockedOnReturn.ToString().ToLower()"
                                        data-refund-status="@o.RefundStatus"
                                        data-admin-notes="@o.ReturnAdminNotes">
                                    <i class="fa-solid fa-gavel me-1"></i>Inspect &amp; Resolve
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- PROCESS RETURN MODAL -->
<div class="modal fade" id="processReturnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-xl rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title font-heading fw-bold">Return &amp; Refund Resolution</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="ProcessReturn" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" id="modalOrderId" />
                <div class="modal-body">
                    <div class="p-3 bg-light rounded-3 mb-3">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Target Order:</span>
                            <strong id="modalOrderNumber" class="font-monospace">#--</strong>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted small">Customer Stated Reason:</span>
                            <span id="modalReturnReason" class="small fw-semibold">--</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Governance Decision</label>
                        <select name="decision" id="modalDecisionSelect" class="form-select" required>
                            <option value="Approve">Approve Return &amp; Authorize Refund</option>
                            <option value="Reject">Decline / Reject Return Request</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Physical Inspection Assessment</label>
                        <select name="inspectionState" class="form-select">
                            <option value="PassedInspection">Item Passed Inspection (Unopened / Mint Condition)</option>
                            <option value="MinorPackagingDamage">Item Verified Intact (Packaging Minor Damage)</option>
                            <option value="DamagedInTransit">Courier Transit Damage (Carrier Claim Required)</option>
                            <option value="MissingParts">Missing Accessories / Components</option>
                            <option value="RejectedInspection">Failed Inspection (Policy Violation / Used Item)</option>
                        </select>
                    </div>

                    <div id="refundFieldsContainer">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Refund Method</label>
                            <select name="refundMethod" class="form-select">
                                <option value="OriginalPaymentMethod">Original Payment Method</option>
                                <option value="BankTransfer">Direct Interbank IBAN Transfer</option>
                                <option value="EasyPaisa">EasyPaisa Remittance</option>
                                <option value="JazzCash">JazzCash Remittance</option>
                                <option value="StoreCredit">Store Wallet Credit</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Refund Amount (PKR)</label>
                            <input type="number" step="0.01" name="refundAmount" id="modalRefundAmount" class="form-control" required />
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" name="restock" value="true" id="modalRestockCheck" checked>
                            <label class="form-check-label small fw-semibold" for="modalRestockCheck">
                                Restock items back to inventory immediately
                            </label>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-semibold text-muted">Administrator Audit Notes</label>
                        <textarea name="adminNotes" id="modalAdminNotes" class="form-control" rows="3" placeholder="Inspection findings, transaction confirmation details, or justification..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom px-4">Execute Resolution</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-process-return').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('modalOrderId').value = this.dataset.orderId;
                document.getElementById('modalOrderNumber').innerText = '#' + this.dataset.orderNumber;
                document.getElementById('modalReturnReason').innerText = this.dataset.returnReason || 'Not specified';
                document.getElementById('modalRefundAmount').value = this.dataset.totalAmount;
                document.getElementById('modalAdminNotes').value = this.dataset.adminNotes || '';
                
                const isRestocked = this.dataset.isRestocked === 'true';
                const restockCheck = document.getElementById('modalRestockCheck');
                if (isRestocked) {
                    restockCheck.checked = false;
                    restockCheck.disabled = true;
                } else {
                    restockCheck.checked = true;
                    restockCheck.disabled = false;
                }

                new bootstrap.Modal(document.getElementById('processReturnModal')).show();
            });
        });

        document.getElementById('modalDecisionSelect').addEventListener('change', function() {
            const container = document.getElementById('refundFieldsContainer');
            if (this.value === 'Reject') {
                container.style.display = 'none';
            } else {
                container.style.display = 'block';
            }
        });
    </script>
}
