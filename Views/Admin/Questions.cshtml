@model List<HamaraCommerce.Models.QuestionAnswer>
@{
    ViewData["Title"] = "Customer Product Questions";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 font-heading fw-bold mb-1">Customer Q&A Moderation</h2>
        <p class="text-muted small mb-0">Answer pending customer inquiries and moderate public product questions.</p>
    </div>
    <span class="badge bg-primary rounded-pill px-3 py-2">@Model.Count Total Inquiries</span>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Product</th>
                    <th>Customer & Question</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Official Answer</th>
                    <th class="pe-4 text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-comments fs-2 d-block mb-2 opacity-50"></i>
                            No customer questions submitted yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                @if (q.Product != null)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@q.Product.MainImage" class="rounded-2" style="width:36px; height:36px; object-fit:cover;" alt="@q.Product.Title" />
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@q.ProductId" class="fw-bold small text-decoration-none text-dark" target="_blank">
                                            @q.Product.Title
                                        </a>
                                    </div>
                                }
                            </td>
                            <td>
                                <strong class="small text-dark d-block">@q.AskedBy</strong>
                                <span class="small text-muted">"@q.Question"</span>
                            </td>
                            <td class="small text-muted">@q.QuestionDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (q.IsAnswered)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2.5 py-1 small">
                                        <i class="fa-solid fa-check me-1"></i>Answered
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning rounded-pill px-2.5 py-1 small">
                                        Pending Reply
                                    </span>
                                }
                            </td>
                            <td class="small" style="max-width: 250px;">
                                @if (q.IsAnswered)
                                {
                                    <span class="text-dark">@q.Answer</span>
                                    <span class="text-muted d-block small mt-1">By @q.AnsweredBy on @(q.AnswerDate?.ToString("MMM dd, yyyy"))</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">No official reply yet</span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <button class="btn btn-outline-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#answerModal-@q.Id">
                                    <i class="fa-solid fa-reply me-1"></i>@(q.IsAnswered ? "Edit" : "Reply")
                                </button>

                                <!-- Answer Modal -->
                                <div class="modal fade text-start" id="answerModal-@q.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow-xl rounded-4">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title font-heading fw-bold">Reply to Customer Question</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-controller="Admin" asp-action="AnswerQuestion" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@q.Id" />
                                                <div class="modal-body">
                                                    <div class="p-3 bg-light rounded-3 mb-3">
                                                        <span class="small text-muted d-block">Question by @q.AskedBy:</span>
                                                        <strong class="text-dark">@q.Question</strong>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold text-muted">Official Store Response</label>
                                                        <textarea name="answer" class="form-control" rows="4" placeholder="Provide accurate specifications or customer assistance..." required>@q.Answer</textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0">
                                                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary-custom px-4 rounded-pill">Publish Answer</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
