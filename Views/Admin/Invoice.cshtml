@model HamaraCommerce.Models.Order
@{
    ViewData["Title"] = "Tax Invoice #" + Model.Id;
}

<div class="container mt-4 mb-5 max-w-3xl">
    <div class="card border-0 shadow-lg rounded-4 p-5 bg-white">
        <!-- INVOICE HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-5 pb-4 border-bottom">
            <div>
                <h2 class="brand-title text-dark">Hamara<span>Commerce</span></h2>
                <p class="small text-muted mb-0">100 Tech Plaza, Suite 400, Seattle, WA 98101<br>GST/Tax ID: US-984210492</p>
            </div>
            <div class="text-end">
                <h3 class="fw-bold font-heading mb-1 text-primary">TAX INVOICE</h3>
                <span class="font-monospace text-muted d-block">Invoice #: INV-@Model.Id</span>
                <span class="small text-muted">Date: @Model.OrderDate.ToString("MMM dd, yyyy")</span>
            </div>
        </div>

        <!-- ADDRESSES ROW -->
        <div class="row g-4 mb-5">
            <div class="col-6">
                <h6 class="fw-bold text-uppercase small text-muted">Billed To</h6>
                <strong class="d-block text-dark">@Model.CustomerName</strong>
                <p class="small text-muted mb-0">
                    @Model.ShippingAddress<br>
                    @Model.City, @Model.State @Model.PostalCode<br>
                    Email: @Model.CustomerEmail
                </p>
            </div>
            <div class="col-6 text-end">
                <h6 class="fw-bold text-uppercase small text-muted">Order Info</h6>
                <p class="small text-muted mb-0">
                    <strong>Tracking #:</strong> @Model.TrackingNumber<br>
                    <strong>Payment Method:</strong> @Model.PaymentMethod<br>
                    <strong>Status:</strong> <span class="badge bg-success">@Model.Status</span>
                </p>
            </div>
        </div>

        <!-- ITEMS TABLE -->
        <table class="table align-middle mb-4">
            <thead class="bg-light">
                <tr>
                    <th>Item Description</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-bold text-dark">@item.ProductTitle</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.UnitPrice.ToString("C")</td>
                        <td class="text-end fw-bold">@item.TotalPrice.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- SUMMARY -->
        <div class="row justify-content-end mb-4">
            <div class="col-md-5 text-end">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal:</span>
                    <span class="fw-bold">@Model.Subtotal.ToString("C")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tax (8%):</span>
                    <span class="fw-bold">@Model.TaxAmount.ToString("C")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Shipping:</span>
                    <span class="fw-bold">@Model.ShippingFee.ToString("C")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-5 fw-bold text-primary">
                    <span>Total Amount Paid:</span>
                    <span>@Model.TotalAmount.ToString("C")</span>
                </div>
            </div>
        </div>

        <div class="text-center border-top pt-4">
            <p class="small text-muted mb-3">Thank you for shopping with Hamara Commerce!</p>
            <button onclick="window.print()" class="btn btn-navy-custom px-4">
                <i class="fa-solid fa-print me-2"></i>Print Invoice
            </button>
        </div>
    </div>
</div>
