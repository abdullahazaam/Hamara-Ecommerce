@model HamaraCommerce.Models.AdminCustomerListViewModel
@inject HamaraCommerce.Services.IShippingTaxService ShippingTaxService
@{
    ViewData["Title"] = "Customer Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 font-heading fw-bold mb-1">Customer Accounts Directory</h2>
        <p class="text-muted small mb-0">Inspect customer activity, lifetime spend, order history, and manage account statuses.</p>
    </div>
    <span class="badge bg-primary rounded-pill px-3 py-2">@Model.TotalCount Registered Buyers</span>
</div>

<!-- Search Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-card">
    <form asp-controller="Admin" asp-action="Customers" method="get" class="row g-2 align-items-center">
        <div class="col-md-10">
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="search" class="form-control border-0 bg-light" placeholder="Search by Customer Name, Email, or Phone..." value="@Model.SearchTerm" />
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary-custom w-100 rounded-3">Search</button>
        </div>
    </form>
</div>

<!-- Customers Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-card mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Customer Name</th>
                    <th>Email Address</th>
                    <th>Phone</th>
                    <th>Joined Date</th>
                    <th>Total Orders</th>
                    <th>Lifetime Spend</th>
                    <th>Status</th>
                    <th class="pe-4 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Customers.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-users-slash fs-2 d-block mb-2 opacity-50"></i>
                            No customer accounts found matching search.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-controller="Admin" asp-action="CustomerDetails" asp-route-id="@c.Id" class="fw-bold text-dark text-decoration-none d-block">
                                    @c.FullName
                                </a>
                            </td>
                            <td class="small text-muted">@c.Email</td>
                            <td class="small text-muted">@(string.IsNullOrEmpty(c.PhoneNumber) ? "-" : c.PhoneNumber)</td>
                            <td class="small text-muted">@c.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="small fw-bold">@c.TotalOrders</td>
                            <td class="small fw-bold text-primary">@ShippingTaxService.FormatCurrency(c.TotalSpent)</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2.5 py-1 small">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-2.5 py-1 small">Suspended</span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-controller="Admin" asp-action="CustomerDetails" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1">
                                    Orders
                                </a>
                                <form asp-controller="Admin" asp-action="ToggleCustomerStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3" onclick="return confirm('Toggle active status for this user?');">
                                        @(c.IsActive ? "Suspend" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-center">
        <ul class="pagination">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link rounded-pill me-1" asp-action="Customers" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm">Previous</a>
            </li>
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link rounded-pill mx-1" asp-action="Customers" asp-route-page="@p" asp-route-search="@Model.SearchTerm">@p</a>
                </li>
            }
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link rounded-pill ms-1" asp-action="Customers" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm">Next</a>
            </li>
        </ul>
    </nav>
}
