@model List<HamaraCommerce.Models.Category>
@{
    ViewData["Title"] = "Category Taxonomy & Hierarchy";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 font-heading fw-bold mb-1">Category Taxonomy &amp; Hierarchy</h2>
        <p class="text-muted small mb-0">Total @Model.Count categories active in marketplace catalog.</p>
    </div>
    <button class="btn btn-primary-custom rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#categoryModal" onclick="openAddCategoryModal()">
        <i class="fa-solid fa-plus me-1"></i>Add New Category
    </button>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light small text-muted text-uppercase">
                <tr>
                    <th class="ps-4">Icon &amp; Name</th>
                    <th>Slug</th>
                    <th>Parent Category</th>
                    <th>Display Order</th>
                    <th>Published Products</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="fs-4 text-primary p-2 bg-primary-subtle rounded-3" style="width:40px; height:40px; display:flex; align-items:center; justify-content:center;">
                                    <i class="fa-solid @(string.IsNullOrWhiteSpace(c.Icon) ? "fa-box" : c.Icon)"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@c.Name</div>
                                    <div class="small text-muted text-truncate" style="max-width:260px;">@c.Description</div>
                                </div>
                            </div>
                        </td>
                        <td class="font-monospace small">@c.Slug</td>
                        <td>
                            @if (c.ParentCategory != null)
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">@c.ParentCategory.Name</span>
                            }
                            else
                            {
                                <span class="text-muted small">Root Level</span>
                            }
                        </td>
                        <td class="fw-semibold">@c.DisplayOrder</td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border">@c.ProductCount items</span>
                        </td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">Archived</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-1">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-2"
                                        onclick="openEditCategoryModal(@c.Id, '@Html.Raw(c.Name.Replace("'", "\\'"))', '@Html.Raw((c.Icon ?? "fa-box").Replace("'", "\\'"))', '@Html.Raw((c.Description ?? "").Replace("'", "\\'"))', @(c.ParentCategoryId?.ToString() ?? "null"), @c.DisplayOrder)">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                                </button>
                                @if (c.IsActive)
                                {
                                    <form asp-controller="Admin" asp-action="ArchiveCategory" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill px-2" title="Archive Category">
                                            <i class="fa-solid fa-box-archive"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-controller="Admin" asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category? (Active products will prevent hard deletion)');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" title="Delete Category">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CATEGORY MODAL (ADD / EDIT) -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-xl rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title font-heading fw-bold" id="catModalTitle">Add New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="SaveCategory" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="catId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Category Name</label>
                        <input type="text" name="name" id="catName" class="form-control" placeholder="e.g. Smart Home &amp; Automation" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">FontAwesome Icon Class</label>
                        <input type="text" name="icon" id="catIcon" class="form-control" placeholder="fa-house-laptop" value="fa-box" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Parent Category (Optional)</label>
                        <select name="parentCategoryId" id="catParentId" class="form-select">
                            <option value="">-- Top-level / Root Category --</option>
                            @foreach (var p in Model.Where(c => c.ParentCategoryId == null))
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Display Sort Order</label>
                        <input type="number" name="displayOrder" id="catDisplayOrder" class="form-control" value="0" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-semibold text-muted">Short Description</label>
                        <textarea name="description" id="catDescription" class="form-control" rows="3" placeholder="Category summary..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom px-4" id="catSubmitBtn">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAddCategoryModal() {
            document.getElementById('catModalTitle').innerText = 'Add New Category';
            document.getElementById('catSubmitBtn').innerText = 'Create Category';
            document.getElementById('catId').value = '';
            document.getElementById('catName').value = '';
            document.getElementById('catIcon').value = 'fa-box';
            document.getElementById('catParentId').value = '';
            document.getElementById('catDisplayOrder').value = '0';
            document.getElementById('catDescription').value = '';
        }

        function openEditCategoryModal(id, name, icon, desc, parentId, displayOrder) {
            document.getElementById('catModalTitle').innerText = 'Edit Category: ' + name;
            document.getElementById('catSubmitBtn').innerText = 'Save Changes';
            document.getElementById('catId').value = id;
            document.getElementById('catName').value = name;
            document.getElementById('catIcon').value = icon || 'fa-box';
            document.getElementById('catParentId').value = parentId || '';
            document.getElementById('catDisplayOrder').value = displayOrder || 0;
            document.getElementById('catDescription').value = desc || '';
            new bootstrap.Modal(document.getElementById('categoryModal')).show();
        }
    </script>
}
