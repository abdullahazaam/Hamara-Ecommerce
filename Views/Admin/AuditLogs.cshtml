@model HamaraCommerce.Models.AdminAuditLogListViewModel
@{
    ViewData["Title"] = "Security Audit Logs";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 font-heading fw-bold mb-1">Administrative Audit Logs</h2>
        <p class="text-muted small mb-0">Immutable compliance log of administrative actions, price adjustments, and account changes.</p>
    </div>
    <span class="badge bg-primary rounded-pill px-3 py-2">@Model.TotalCount Total Events</span>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-card">
    <form asp-controller="Admin" asp-action="AuditLogs" method="get" class="row g-2 align-items-center">
        <div class="col-md-9">
            <select name="entityFilter" class="form-select border-0 bg-light" onchange="this.form.submit()">
                <option value="">-- All Entity Types --</option>
                <option value="Order" selected="@(Model.EntityFilter == "Order")">Order Operations</option>
                <option value="Product" selected="@(Model.EntityFilter == "Product")">Product & Inventory</option>
                <option value="Customer" selected="@(Model.EntityFilter == "Customer")">Customer Accounts</option>
                <option value="Coupon" selected="@(Model.EntityFilter == "Coupon")">Coupon Management</option>
                <option value="Settings" selected="@(Model.EntityFilter == "Settings")">Store Settings</option>
                <option value="Review" selected="@(Model.EntityFilter == "Review")">Review Moderation</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary-custom w-100 rounded-3">Filter Logs</button>
        </div>
    </form>
</div>

<!-- Logs Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-card mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Timestamp (UTC)</th>
                    <th>Administrator</th>
                    <th>Action</th>
                    <th>Entity Type</th>
                    <th>Entity Ref</th>
                    <th>Operation Details</th>
                    <th class="pe-4">IP Address</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Logs.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-shield-halved fs-2 d-block mb-2 opacity-50"></i>
                            No audit logs recorded matching filter.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td class="ps-4 small text-muted font-monospace">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <strong class="small text-dark d-block">@log.AdminUserName</strong>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary rounded-pill px-2.5 py-1 text-xs font-monospace">
                                    @log.Action
                                </span>
                            </td>
                            <td class="small fw-semibold">@log.EntityType</td>
                            <td class="small font-monospace text-muted">@(string.IsNullOrEmpty(log.EntityId) ? "-" : log.EntityId)</td>
                            <td class="small text-dark" style="max-width: 360px;">@log.Details</td>
                            <td class="pe-4 small text-muted font-monospace">@(string.IsNullOrEmpty(log.IpAddress) ? "Localhost" : log.IpAddress)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Bounded Pagination -->
@await Html.PartialAsync("_AdminPagination", new AdminPaginationViewModel
{
    CurrentPage = Model.CurrentPage,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    PageSize = Model.PageSize,
    Action = "AuditLogs",
    Controller = "Admin"
})
