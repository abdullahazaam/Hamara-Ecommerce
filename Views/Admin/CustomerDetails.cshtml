@model List<HamaraCommerce.Models.Order>
@inject HamaraCommerce.Services.IShippingTaxService ShippingTaxService
@{
    var customer = ViewBag.Customer as HamaraCommerce.Models.ApplicationUser;
    ViewData["Title"] = "Customer Profile - " + (customer?.FullName ?? "User");
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-controller="Admin" asp-action="Customers" class="btn btn-glass btn-sm rounded-pill px-3">
                <i class="fa-solid fa-arrow-left me-1"></i>Customers List
            </a>
            <span class="badge @(customer?.IsActive == true ? "bg-success" : "bg-danger")">
                @(customer?.IsActive == true ? "Active Account" : "Suspended Account")
            </span>
        </div>
        <h2 class="h4 font-heading fw-bold mb-0">@(customer?.FullName ?? "Customer")'s Profile & Order History</h2>
    </div>
</div>

<div class="row g-4">
    <!-- Profile Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-card mb-4 text-center">
            <img src="@(string.IsNullOrEmpty(customer?.AvatarUrl) ? "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=250&q=80" : customer.AvatarUrl)" 
                 class="rounded-circle border border-3 border-primary mx-auto mb-3 shadow-sm" style="width:90px; height:90px; object-fit:cover;" alt="Avatar" />
            <h5 class="fw-bold text-dark mb-1">@customer?.FullName</h5>
            <p class="small text-muted mb-3">@customer?.Email</p>

            <div class="text-start border-top pt-3 small">
                <div class="mb-2"><strong>Phone:</strong> @(customer?.PhoneNumber ?? "Not provided")</div>
                <div class="mb-2"><strong>Member Since:</strong> @customer?.CreatedAt.ToString("MMM dd, yyyy")</div>
                <div class="mb-2"><strong>Total Orders:</strong> @Model.Count</div>
                <div class="mb-0"><strong>Lifetime Spend:</strong> <span class="text-primary fw-bold">@ShippingTaxService.FormatCurrency(Model.Where(o => o.Status != OrderStatus.Cancelled).Sum(o => o.TotalAmount))</span></div>
            </div>
        </div>
    </div>

    <!-- Customer's Order History -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-card">
            <div class="p-3 bg-light border-bottom">
                <h5 class="fw-bold font-heading mb-0 text-dark">Order History (@Model.Count)</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Order Ref</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th class="pe-4 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">This customer has not placed any orders yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var o in Model)
                            {
                                <tr>
                                    <td class="ps-4 font-monospace fw-bold text-primary">@o.OrderNumber</td>
                                    <td class="small text-muted">@o.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="badge bg-secondary rounded-pill px-2.5 py-1 small">@o.Status</span>
                                    </td>
                                    <td class="small fw-bold">@ShippingTaxService.FormatCurrency(o.TotalAmount)</td>
                                    <td class="pe-4 text-end">
                                        <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@o.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
