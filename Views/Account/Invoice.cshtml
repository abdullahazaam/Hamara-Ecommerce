@model HamaraCommerce.Models.Order
@inject HamaraCommerce.Services.IShippingTaxService ShippingTaxService
@{
    ViewData["Title"] = "Tax Invoice #" + Model.OrderNumber;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tax Invoice — @Model.OrderNumber — Hamara Commerce</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { background: #080d1a; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: #0f172a; margin: 0; padding: 20px; }
        .invoice-card { background: #ffffff; max-width: 850px; margin: 20px auto; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.4); padding: 40px; }
        .font-heading { font-family: 'Outfit', system-ui, sans-serif; }
        .brand-pill { background: linear-gradient(135deg, #2563eb, #7c3aed); color: #fff; padding: 6px 14px; border-radius: 9999px; font-weight: 700; display: inline-flex; align-items: center; }
        @@media print {
            body { background: #ffffff; margin: 0; padding: 0; }
            .invoice-card { box-shadow: none; margin: 0; padding: 0; max-width: 100%; border-radius: 0; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="invoice-card">
        <!-- Header Controls -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom no-print">
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="fa-solid fa-arrow-left me-1"></i>Back
            </a>
            <button onclick="window.print()" class="btn btn-primary btn-sm rounded-pill px-4" style="background:linear-gradient(135deg,#2563eb,#7c3aed); border:none;">
                <i class="fa-solid fa-print me-2"></i>Print Invoice
            </button>
        </div>

        <!-- Brand & Invoice Title -->
        <div class="row align-items-center mb-4">
            <div class="col-sm-6">
                <div class="brand-pill mb-2">
                    <i class="fa-solid fa-bag-shopping me-2"></i>Hamara Commerce
                </div>
                <p class="text-muted small mb-0">Online Marketplace • Pakistan</p>
                <p class="text-muted small mb-0">NTN: 8941029-4 • support@hamaracommerce.com</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                <h4 class="font-heading fw-bold mb-1" style="color:#0f172a;">TAX INVOICE</h4>
                <div class="fw-bold text-primary font-monospace fs-6">@Model.OrderNumber</div>
                <div class="small text-muted">Date: @Model.OrderDate.ToString("MMM dd, yyyy HH:mm") UTC</div>
                <div class="small text-muted">Tracking: <span class="font-monospace">@Model.TrackingNumber</span></div>
            </div>
        </div>

        <hr />

        <!-- Customer & Delivery Info -->
        <div class="row g-4 mb-4">
            <div class="col-sm-6">
                <h6 class="fw-bold text-uppercase text-xs text-muted mb-2">Billed &amp; Shipped To:</h6>
                <div class="fw-bold text-dark">@Model.CustomerName</div>
                <div class="small text-muted">@Model.CustomerPhone</div>
                <div class="small text-muted">@Model.CustomerEmail</div>
                <div class="small text-dark mt-1">
                    @Model.ShippingAddress<br />
                    @Model.City, @Model.State @Model.PostalCode<br />
                    @Model.Country
                </div>
            </div>
            <div class="col-sm-6 text-sm-end">
                <h6 class="fw-bold text-uppercase text-xs text-muted mb-2">Order Information:</h6>
                <div class="small mb-1"><strong>Payment Method:</strong> @Model.PaymentMethod</div>
                <div class="small mb-1"><strong>Payment Status:</strong> <span class="badge @(Model.PaymentStatus == PaymentStatus.Paid ? "bg-success" : "bg-warning text-dark")">@Model.PaymentStatus</span></div>
                <div class="small mb-1"><strong>Shipping Carrier:</strong> @Model.ShippingMethod</div>
                <div class="small"><strong>Order Status:</strong> @Model.Status</div>
            </div>
        </div>

        <!-- Items Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50%;">Product Description</th>
                        <th class="text-center">SKU</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.ProductTitle</strong>
                                @if (!string.IsNullOrEmpty(item.VariantName))
                                {
                                    <span class="badge bg-secondary-subtle text-secondary small d-block mt-1">@item.VariantName</span>
                                }
                            </td>
                            <td class="text-center font-monospace small">@(string.IsNullOrEmpty(item.SKU) ? "-" : item.SKU)</td>
                            <td class="text-center fw-bold">@item.Quantity</td>
                            <td class="text-end">@ShippingTaxService.FormatCurrency(item.UnitPrice, Model.Currency)</td>
                            <td class="text-end fw-bold">@ShippingTaxService.FormatCurrency(item.TotalPrice, Model.Currency)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Financial Summary -->
        <div class="row justify-content-end mb-4">
            <div class="col-sm-6">
                <table class="table table-sm table-borderless">
                    <tr>
                        <td class="text-muted">Subtotal:</td>
                        <td class="text-end fw-semibold">@ShippingTaxService.FormatCurrency(Model.Subtotal, Model.Currency)</td>
                    </tr>
                    @if (Model.DiscountAmount > 0)
                    {
                        <tr class="text-success">
                            <td>Coupon Discount @(Model.CouponCode != null ? $"({Model.CouponCode})" : ""):</td>
                            <td class="text-end fw-bold">-@ShippingTaxService.FormatCurrency(Model.DiscountAmount, Model.Currency)</td>
                        </tr>
                    }
                    <tr>
                        <td class="text-muted">Sales Tax (GST):</td>
                        <td class="text-end fw-semibold">@ShippingTaxService.FormatCurrency(Model.TaxAmount, Model.Currency)</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Shipping Fee (@Model.ShippingMethod):</td>
                        <td class="text-end fw-semibold">@(Model.ShippingFee == 0 ? "FREE" : ShippingTaxService.FormatCurrency(Model.ShippingFee, Model.Currency))</td>
                    </tr>
                    <tr class="border-top fs-5">
                        <td class="fw-bold">Grand Total:</td>
                        <td class="text-end fw-bold text-primary">@ShippingTaxService.FormatCurrency(Model.TotalAmount, Model.Currency)</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="border-top pt-3 text-center text-muted small">
            <p class="mb-1">Thank you for shopping with Hamara Commerce! For questions or returns, contact support@hamaracommerce.com</p>
            <p class="mb-0 text-xs">This is a computer-generated tax invoice. No physical signature required.</p>
        </div>
    </div>
</body>
</html>
