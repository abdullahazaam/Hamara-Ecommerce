@{
    ViewData["Title"] = "Password Reset Requested";
    var resetLink = TempData["ResetLinkPreview"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
            <div class="card border-0 shadow-xl rounded-4 overflow-hidden text-center p-4 p-md-5">
                <div class="p-3 bg-success/10 text-success rounded-circle d-inline-block mx-auto mb-3" style="width:70px; height:70px;">
                    <i class="fa-solid fa-envelope-circle-check fs-2"></i>
                </div>
                <h2 class="h4 font-heading fw-bold mb-2">Check Your Email</h2>
                <p class="text-muted small mb-4">
                    If an account exists with the provided email, a secure password reset link has been dispatched. Please check your inbox and spam folder.
                </p>

                @if (!string.IsNullOrEmpty(resetLink))
                {
                    <div class="alert alert-info small text-start rounded-3 mb-4">
                        <i class="fa-solid fa-code me-1"></i><strong>Development Preview:</strong><br />
                        <a href="@resetLink" class="text-break text-primary fw-bold">Click here to reset your password now</a>
                    </div>
                }

                <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom rounded-pill py-2 px-4">
                    Return to Sign In
                </a>
            </div>
        </div>
    </div>
</div>
