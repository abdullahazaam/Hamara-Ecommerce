@{
    ViewData["Title"] = "Access Restricted";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-xl rounded-4 overflow-hidden text-center p-4 p-md-5">
                <div class="p-3 bg-danger/10 text-danger rounded-circle d-inline-block mx-auto mb-3" style="width:75px; height:75px;">
                    <i class="fa-solid fa-shield-halved fs-1"></i>
                </div>
                <h2 class="h3 font-heading fw-bold mb-2">Access Restricted</h2>
                <p class="text-muted mb-4">
                    You do not have the necessary permissions to access this administrative resource or private record.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-glass rounded-pill px-4">
                        <i class="fa-solid fa-house me-2"></i>Return Home
                    </a>
                    <a asp-controller="Account" asp-action="Index" class="btn btn-primary-custom rounded-pill px-4">
                        <i class="fa-solid fa-user me-2"></i>Customer Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
