@model HamaraCommerce.Models.ResendEmailConfirmationViewModel
@{
    ViewData["Title"] = "Resend Verification Email";
}

<div class="row justify-content-center py-5 reveal-on-scroll">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card-glass rounded-4 p-4 p-md-5 position-relative overflow-hidden"
             style="background:var(--bg-glass); backdrop-filter:blur(24px); border:1px solid var(--border-default) !important; box-shadow:var(--shadow-xl);">
            
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 p-3"
                     style="width: 64px; height: 64px; background: rgba(37, 99, 235, 0.15); color: #2563eb;">
                    <i class="fa-solid fa-paper-plane fs-4"></i>
                </div>
                <h1 class="h4 font-heading fw-bold mb-1" style="color:var(--text-primary); letter-spacing:-0.02em;">Resend Verification</h1>
                <p class="small mb-0" style="color:var(--text-muted);">Enter your registered email address to receive a fresh account verification link.</p>
            </div>

            <form asp-controller="Account" asp-action="ResendEmailConfirmation" method="post">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3 mb-3"></div>
                }

                <div class="mb-4">
                    <label asp-for="Email" class="form-label small fw-bold" style="color:var(--text-muted);">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text rounded-start-3" style="border-color:var(--border-default);"><i class="fa-regular fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control rounded-end-3" placeholder="name@example.com" autofocus required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2.5 rounded-pill shadow-sm mb-3">
                    <i class="fa-solid fa-paper-plane me-1"></i>Send Verification Email
                </button>

                <div class="text-center small" style="color:var(--text-muted);">
                    <a asp-action="Login" class="fw-bold text-decoration-none" style="color:var(--brand-primary);">Back to Sign In</a>
                </div>
            </form>
        </div>
    </div>
</div>
