@model HamaraCommerce.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center py-5 reveal-on-scroll">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card-glass rounded-4 p-4 p-md-5 position-relative overflow-hidden"
             style="background:var(--bg-glass); backdrop-filter:blur(24px); border:1px solid var(--border-default) !important; box-shadow:var(--shadow-xl);">
            
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex mx-auto mb-3 p-3"
                     style="width: 64px; height: 64px; background: rgba(37,99,235,0.15); color: #60a5fa; align-items: center; justify-content: center; box-shadow:0 0 25px rgba(37,99,235,0.20);">
                    <i class="fa-solid fa-key fs-3"></i>
                </div>
                <h1 class="h4 font-heading fw-bold mb-1" style="color:var(--text-primary); letter-spacing:-0.02em;">Set New Password</h1>
                <p class="small mb-0" style="color:var(--text-muted);">Please create a strong new password for your account.</p>
            </div>

            <form asp-controller="Account" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Code" />

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3 mb-3"></div>
                }

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-bold" style="color:var(--text-muted);">Account Email</label>
                    <div class="input-group">
                        <span class="input-group-text rounded-start-3" style="border-color:var(--border-default);"><i class="fa-regular fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control rounded-end-3" readonly />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-bold" style="color:var(--text-muted);">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text rounded-start-3" style="border-color:var(--border-default);"><i class="fa-regular fa-lock"></i></span>
                        <input asp-for="Password" class="form-control rounded-end-3" type="password" placeholder="At least 6 characters" autocomplete="new-password" autofocus required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-bold" style="color:var(--text-muted);">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text rounded-start-3" style="border-color:var(--border-default);"><i class="fa-solid fa-lock"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control rounded-end-3" type="password" placeholder="Repeat new password" autocomplete="new-password" required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2.5 rounded-pill shadow-sm mb-3">
                    <i class="fa-solid fa-check me-2"></i>Update Password
                </button>
            </form>
        </div>
    </div>
</div>
