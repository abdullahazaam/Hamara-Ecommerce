@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
            <div class="card border-0 shadow-xl rounded-4 overflow-hidden text-center p-4 p-md-5">
                <div class="p-3 bg-success/10 text-success rounded-circle d-inline-block mx-auto mb-3" style="width:70px; height:70px;">
                    <i class="fa-solid fa-circle-check fs-2"></i>
                </div>
                <h2 class="h4 font-heading fw-bold mb-2">Password Reset Successful</h2>
                <p class="text-muted small mb-4">
                    Your password has been reset successfully. You can now sign in using your new credentials.
                </p>

                <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom rounded-pill py-2 px-4">
                    <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Sign In Now
                </a>
            </div>
        </div>
    </div>
</div>
