@model HamaraCommerce.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center py-5 reveal-on-scroll">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card-glass rounded-4 p-4 p-md-5 position-relative overflow-hidden"
             style="background:var(--bg-glass); backdrop-filter:blur(24px); border:1px solid var(--border-default) !important; box-shadow:var(--shadow-xl);">
            
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex mx-auto mb-3 p-3"
                     style="width: 64px; height: 64px; background: rgba(37,99,235,0.15); color: #60a5fa; align-items: center; justify-content: center; box-shadow:0 0 25px rgba(37,99,235,0.20);">
                    <i class="fa-solid fa-unlock-keyhole fs-3"></i>
                </div>
                <h1 class="h4 font-heading fw-bold mb-1" style="color:var(--text-primary); letter-spacing:-0.02em;">Reset Your Password</h1>
                <p class="small mb-0" style="color:var(--text-muted);">Enter your registered account email and we'll dispatch a secure recovery token.</p>
            </div>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3 mb-3"></div>
                }

                <div class="mb-4">
                    <label asp-for="Email" class="form-label small fw-bold" style="color:var(--text-muted);">Registered Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text rounded-start-3" style="border-color:var(--border-default);"><i class="fa-regular fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control rounded-end-3" placeholder="name@example.com" autocomplete="email" autofocus required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2.5 rounded-pill shadow-sm mb-3">
                    <i class="fa-solid fa-paper-plane me-2"></i>Send Reset Link
                </button>

                <div class="text-center mt-3">
                    <a asp-controller="Account" asp-action="Login" class="small fw-semibold text-decoration-none" style="color:var(--brand-primary);">
                        <i class="fa-solid fa-arrow-left me-1"></i>Back to Sign In
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
