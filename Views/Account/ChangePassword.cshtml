@model HamaraCommerce.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
            <div class="card border-0 shadow-xl rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="p-3 bg-primary/10 text-primary rounded-circle d-inline-block mb-3">
                            <i class="fa-solid fa-key fs-3"></i>
                        </div>
                        <h2 class="h4 font-heading fw-bold mb-1">Update Security Credentials</h2>
                        <p class="text-muted small">Choose a strong, unique password to protect your account</p>
                    </div>

                    <form asp-controller="Account" asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label small fw-semibold text-muted"></label>
                            <input asp-for="CurrentPassword" class="form-control border-0 bg-light py-2" placeholder="Enter current password" autocomplete="current-password" autofocus />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label small fw-semibold text-muted"></label>
                            <input asp-for="NewPassword" class="form-control border-0 bg-light py-2" placeholder="At least 6 characters" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label small fw-semibold text-muted"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control border-0 bg-light py-2" placeholder="Confirm new password" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary-custom w-100 py-2.5 fw-bold fs-6 rounded-3">
                            <i class="fa-solid fa-shield-check me-2"></i>Update Password
                        </button>

                        <div class="text-center mt-3">
                            <a asp-controller="Account" asp-action="Index" class="small text-muted text-decoration-none">
                                <i class="fa-solid fa-arrow-left me-1"></i>Back to My Account
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
