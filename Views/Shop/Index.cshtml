@model HamaraCommerce.Models.ShopFilterViewModel
@{
    ViewData["Title"] = !string.IsNullOrEmpty(Model.Category) ? $"{Model.Category} — Shop Catalog" : "Shop Collection";
}

<!-- Catalog Header & Breadcrumb Banner -->
<div class="card-glass p-4 p-md-5 mb-4 rounded-4 border-0 position-relative overflow-hidden reveal-on-scroll"
     style="background: linear-gradient(135deg, rgba(37,99,235,0.09) 0%, rgba(124,58,237,0.06) 50%, rgba(6,182,212,0.05) 100%); border: 1px solid var(--border-default) !important;">
    <div class="position-relative" style="z-index: 2;">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color:var(--text-muted);">Home</a></li>
                @if (!string.IsNullOrEmpty(Model.Category))
                {
                    <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-decoration-none" style="color:var(--text-muted);">Catalog</a></li>
                    <li class="breadcrumb-item active fw-bold" style="color:var(--brand-primary);" aria-current="page">@Model.Category</li>
                }
                else
                {
                    <li class="breadcrumb-item active fw-bold" style="color:var(--brand-primary);" aria-current="page">All Products</li>
                }
            </ol>
        </nav>

        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <h1 class="h2 font-heading fw-extrabold mb-1" style="color:var(--text-primary); letter-spacing:-0.02em;">
                    @(!string.IsNullOrEmpty(Model.Category) ? Model.Category : "Curated Collection")
                </h1>
                <p class="mb-0 small" style="color:var(--text-muted);">
                    Showing <strong>@Model.Products.Count</strong> of <strong>@Model.TotalItems</strong> catalogue products
                </p>
            </div>

            <!-- Sort and Mobile Filter trigger -->
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-glass btn-sm rounded-pill d-lg-none px-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas" aria-controls="filterOffcanvas">
                    <i class="fa-solid fa-sliders me-1.5" style="color:var(--brand-primary);"></i>Filter Catalog
                </button>

                <form asp-controller="Shop" asp-action="Index" method="get" id="sortForm" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="category" value="@Model.Category" />
                    <input type="hidden" name="search" value="@Model.SearchQuery" />
                    <input type="hidden" name="brand" value="@Model.SelectedBrand" />
                    <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                    <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                    <input type="hidden" name="inStockOnly" value="@(Model.InStockOnly ? "true" : "")" />
                    <input type="hidden" name="onSaleOnly" value="@(Model.OnSaleOnly ? "true" : "")" />
                    <input type="hidden" name="flashDeal" value="@(Model.FlashDealOnly ? "true" : "")" />

                    <label for="sortSelect" class="small fw-semibold text-nowrap d-none d-sm-inline" style="color:var(--text-muted);">Sort by:</label>
                    <select id="sortSelect" name="sortBy" class="form-select form-select-sm rounded-pill px-3" style="min-width: 175px;" onchange="document.getElementById('sortForm').submit();">
                        <option value="recommended" selected="@(Model.SortBy == "recommended" || string.IsNullOrEmpty(Model.SortBy))">Recommended</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                        <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                        <option value="discount" selected="@(Model.SortBy == "discount")">Best Discount</option>
                        <option value="rating" selected="@(Model.SortBy == "rating" || Model.SortBy == "customer_rated")">Customer Rated</option>
                    </select>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Active Filter Chips -->
@if (!string.IsNullOrEmpty(Model.Category) || !string.IsNullOrEmpty(Model.SelectedBrand) || !string.IsNullOrEmpty(Model.SearchQuery) || Model.MinPrice.HasValue || Model.MaxPrice.HasValue || Model.InStockOnly || Model.OnSaleOnly || Model.FlashDealOnly)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4 p-3 rounded-4" style="background:var(--bg-surface-elevated); border:1px solid var(--border-subtle);">
        <span class="small fw-bold text-uppercase" style="color:var(--text-muted); font-size:0.75rem; letter-spacing:0.05em;">Active Filters:</span>
        @if (!string.IsNullOrEmpty(Model.Category))
        {
            <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-brand="@Model.SelectedBrand" asp-route-sortBy="@Model.SortBy" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-inStockOnly="@Model.InStockOnly" asp-route-onSaleOnly="@Model.OnSaleOnly" asp-route-flashDeal="@(Model.FlashDealOnly ? "true" : null)"
               class="badge bg-primary-subtle text-primary border border-primary text-decoration-none rounded-pill py-1.5 px-3 small d-inline-flex align-items-center gap-1">
                Category: @Model.Category <i class="fa-solid fa-xmark ms-1"></i>
            </a>
        }
        @if (!string.IsNullOrEmpty(Model.SelectedBrand))
        {
            <a asp-action="Index" asp-route-category="@Model.Category" asp-route-search="@Model.SearchQuery" asp-route-sortBy="@Model.SortBy" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-inStockOnly="@Model.InStockOnly" asp-route-onSaleOnly="@Model.OnSaleOnly" asp-route-flashDeal="@(Model.FlashDealOnly ? "true" : null)"
               class="badge bg-primary-subtle text-primary border border-primary text-decoration-none rounded-pill py-1.5 px-3 small d-inline-flex align-items-center gap-1">
                Brand: @Model.SelectedBrand <i class="fa-solid fa-xmark ms-1"></i>
            </a>
        }
        @if (!string.IsNullOrEmpty(Model.SearchQuery))
        {
            <a asp-action="Index" asp-route-category="@Model.Category" asp-route-brand="@Model.SelectedBrand" asp-route-sortBy="@Model.SortBy" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-inStockOnly="@Model.InStockOnly" asp-route-onSaleOnly="@Model.OnSaleOnly" asp-route-flashDeal="@(Model.FlashDealOnly ? "true" : null)"
               class="badge bg-primary-subtle text-primary border border-primary text-decoration-none rounded-pill py-1.5 px-3 small d-inline-flex align-items-center gap-1">
                Keyword: "@Model.SearchQuery" <i class="fa-solid fa-xmark ms-1"></i>
            </a>
        }
        @if (Model.FlashDealOnly)
        {
            <a asp-action="Index" asp-route-category="@Model.Category" asp-route-search="@Model.SearchQuery" asp-route-brand="@Model.SelectedBrand" asp-route-sortBy="@Model.SortBy" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-inStockOnly="@Model.InStockOnly" asp-route-onSaleOnly="@Model.OnSaleOnly"
               class="badge bg-warning-subtle text-warning border border-warning text-decoration-none rounded-pill py-1.5 px-3 small d-inline-flex align-items-center gap-1">
                <i class="fa-solid fa-bolt me-1"></i>Flash Deals Only <i class="fa-solid fa-xmark ms-1"></i>
            </a>
        }
        @if (Model.InStockOnly)
        {
            <a asp-action="Index" asp-route-category="@Model.Category" asp-route-search="@Model.SearchQuery" asp-route-brand="@Model.SelectedBrand" asp-route-sortBy="@Model.SortBy" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-onSaleOnly="@Model.OnSaleOnly" asp-route-flashDeal="@(Model.FlashDealOnly ? "true" : null)"
               class="badge bg-success-subtle text-success border border-success text-decoration-none rounded-pill py-1.5 px-3 small d-inline-flex align-items-center gap-1">
                In Stock Only <i class="fa-solid fa-xmark ms-1"></i>
            </a>
        }
        @if (Model.OnSaleOnly)
        {
            <a asp-action="Index" asp-route-category="@Model.Category" asp-route-search="@Model.SearchQuery" asp-route-brand="@Model.SelectedBrand" asp-route-sortBy="@Model.SortBy" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-inStockOnly="@Model.InStockOnly" asp-route-flashDeal="@(Model.FlashDealOnly ? "true" : null)"
               class="badge bg-danger-subtle text-danger border border-danger text-decoration-none rounded-pill py-1.5 px-3 small d-inline-flex align-items-center gap-1">
                On Sale <i class="fa-solid fa-xmark ms-1"></i>
            </a>
        }
        <a asp-action="Index" class="small fw-bold text-decoration-none ms-2" style="color:var(--status-danger);">
            <i class="fa-solid fa-trash-can me-1"></i>Clear All
        </a>
    </div>
}

<div class="row g-4">
    <!-- Desktop Sidebar Filters -->
    <aside class="col-lg-3 d-none d-lg-block">
        <div class="card border-0 shadow-sm rounded-4 p-4 position-sticky" style="top: 85px; background:var(--bg-glass); backdrop-filter:blur(20px); border:1px solid var(--border-default) !important;">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color:var(--border-subtle) !important;">
                <h2 class="h6 font-heading fw-bold mb-0" style="color:var(--text-primary);"><i class="fa-solid fa-filter me-2" style="color:var(--brand-primary);"></i>Refine Results</h2>
                <a asp-action="Index" class="text-xs fw-semibold text-decoration-none" style="color:var(--text-muted);">Reset</a>
            </div>

            <form asp-controller="Shop" asp-action="Index" method="get">
                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                <input type="hidden" name="search" value="@Model.SearchQuery" />

                <!-- Departments & Categories -->
                <div class="mb-4">
                    <label class="form-label small fw-bold text-uppercase" style="color:var(--text-muted); font-size: 0.725rem; letter-spacing:0.05em;">Departments</label>
                    <div class="d-flex flex-column gap-1.5" style="max-height: 480px; overflow-y: auto; padding-right: 4px;">
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="radio" name="category" value="" id="catAll" checked="@(string.IsNullOrEmpty(Model.Category))" onchange="this.form.submit()" />
                            <label class="form-check-label small fw-semibold" for="catAll" style="color:var(--text-primary); cursor:pointer;">
                                <i class="fa-solid fa-layer-group me-1.5 text-primary"></i>All Departments
                            </label>
                        </div>
                        @{
                            var parentDepts = Model.Categories.Where(c => c.ParentCategoryId == null).OrderBy(c => c.DisplayOrder).ToList();
                        }
                        @foreach (var dept in parentDepts)
                        {
                            var isDeptActive = Model.Category == dept.Slug;
                            var childSlugs = dept.SubCategories.Select(sc => sc.Slug).ToHashSet();
                            var isChildActive = !string.IsNullOrEmpty(Model.Category) && childSlugs.Contains(Model.Category);
                            var isExpanded = isDeptActive || isChildActive;
                            var collapseId = $"subcat_col_{dept.Id}";

                            <div class="dept-box rounded-3 p-1.5 mb-1" style="background:var(--bg-surface-elevated); border:1px solid @(isExpanded ? "var(--brand-primary)" : "var(--border-subtle)");">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="form-check mb-0 flex-grow-1 text-truncate">
                                        <input class="form-check-input" type="radio" name="category" value="@dept.Slug" id="dept_@dept.Id" checked="@isDeptActive" onchange="this.form.submit()" />
                                        <label class="form-check-label small fw-semibold text-truncate @(isDeptActive ? "text-primary" : "")" for="dept_@dept.Id" style="cursor:pointer; color:var(--text-primary);" title="@dept.Name">
                                            <i class="fa-solid @dept.Icon me-1.5 text-primary" style="font-size:0.8rem; width:14px;"></i>
                                            @dept.Name
                                        </label>
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge rounded-pill" style="background:var(--bg-secondary); color:var(--text-muted); font-size:0.68rem;">@dept.ProductCount</span>
                                        @if (dept.SubCategories.Any())
                                        {
                                            <a class="btn btn-sm btn-link p-0 text-decoration-none text-muted" data-bs-toggle="collapse" href="#@collapseId" role="button" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@collapseId">
                                                <i class="fa-solid fa-chevron-down" style="font-size:0.65rem;"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                                @if (dept.SubCategories.Any())
                                {
                                    <div class="collapse @(isExpanded ? "show" : "") mt-1 ps-3 pt-1 border-top" id="@collapseId" style="border-color:var(--border-subtle) !important;">
                                        @foreach (var sub in dept.SubCategories.OrderBy(s => s.DisplayOrder))
                                        {
                                            var isSubActive = Model.Category == sub.Slug;
                                            <div class="form-check py-0.5 mb-0">
                                                <input class="form-check-input" type="radio" name="category" value="@sub.Slug" id="sub_@sub.Id" checked="@isSubActive" onchange="this.form.submit()" />
                                                <label class="form-check-label small d-flex justify-content-between align-items-center @(isSubActive ? "fw-bold text-primary" : "text-muted")" for="sub_@sub.Id" style="cursor:pointer; font-size:0.75rem;">
                                                    <span class="text-truncate">@sub.Name</span>
                                                    <span class="badge rounded-pill bg-light text-secondary ms-1" style="font-size:0.62rem;">@sub.ProductCount</span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Brands Filter -->
                @if (Model.Brands != null && Model.Brands.Any())
                {
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase" style="color:var(--text-muted); font-size: 0.725rem; letter-spacing:0.05em;">Brands</label>
                        <div class="d-flex flex-column gap-2" style="max-height: 180px; overflow-y: auto;">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="brand" value="" id="brandAll" checked="@(string.IsNullOrEmpty(Model.SelectedBrand))" onchange="this.form.submit()" />
                                <label class="form-check-label small fw-semibold" for="brandAll" style="color:var(--text-primary);">All Brands</label>
                            </div>
                            @foreach (var b in Model.Brands)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="brand" value="@b" id="brand_@b.Replace(" ", "_")" checked="@(Model.SelectedBrand == b)" onchange="this.form.submit()" />
                                    <label class="form-check-label small" for="brand_@b.Replace(" ", "_")" style="color:var(--text-secondary);">@b</label>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Price Range -->
                <div class="mb-4">
                    <label class="form-label small fw-bold text-uppercase" style="color:var(--text-muted); font-size: 0.725rem; letter-spacing:0.05em;">Price Range (PKR)</label>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <input type="number" name="minPrice" class="form-control form-control-sm rounded-3" placeholder="Min" value="@Model.MinPrice" />
                        </div>
                        <div class="col-6">
                            <input type="number" name="maxPrice" class="form-control form-control-sm rounded-3" placeholder="Max" value="@Model.MaxPrice" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-glass btn-sm w-100 rounded-pill py-1.5 font-heading fw-bold">Apply Price</button>
                </div>

                <!-- Stock, Deals & Flash Toggles -->
                <div class="pt-2 border-top" style="border-color:var(--border-subtle) !important;">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="flashDeal" value="true" id="flashDealSwitch" checked="@Model.FlashDealOnly" onchange="this.form.submit()" />
                        <label class="form-check-label small fw-semibold" for="flashDealSwitch" style="color:var(--text-primary);"><i class="fa-solid fa-bolt text-warning me-1"></i>Flash Deals Only</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="inStockOnly" value="true" id="inStockSwitch" checked="@Model.InStockOnly" onchange="this.form.submit()" />
                        <label class="form-check-label small fw-semibold" for="inStockSwitch" style="color:var(--text-primary);">In Stock Only</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="onSaleOnly" value="true" id="onSaleSwitch" checked="@Model.OnSaleOnly" onchange="this.form.submit()" />
                        <label class="form-check-label small fw-semibold" for="onSaleSwitch" style="color:var(--text-primary);">Discounted Deals</label>
                    </div>
                </div>
            </form>
        </div>
    </aside>

    <!-- Main Product Grid -->
    <section class="col-lg-9">
        @if (!Model.Products.Any())
        {
            @await Html.PartialAsync("_EmptyState", ("fa-solid fa-box-open", "No products match your criteria", "We couldn't find items with your selected combination of filters. Try resetting filters or using a broader search keyword.", Url.Action("Index", "Shop") ?? "/Shop", "Browse Full Catalog"))
        }
        else
        {
            <div class="row g-3">
                @foreach (var (product, idx) in Model.Products.Select((p, i) => (p, i)))
                {
                    <div class="col-xl-4 col-sm-6 reveal-on-scroll" style="transition-delay: @((idx % 6) * 60)ms">
                        @await Html.PartialAsync("_ProductCard", product)
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                int maxDesktop = 6;
                int startPage = Math.Max(1, Model.CurrentPage - 2);
                int endPage = Math.Min(Model.TotalPages, startPage + maxDesktop - 1);
                startPage = Math.Max(1, endPage - maxDesktop + 1);

                int maxMobile = 3;
                int mobileStart = Math.Max(1, Model.CurrentPage - 1);
                int mobileEnd = Math.Min(Model.TotalPages, mobileStart + maxMobile - 1);
                mobileStart = Math.Max(1, mobileEnd - maxMobile + 1);

                <nav aria-label="Catalog pagination" class="mt-5 d-flex justify-content-center w-100" style="max-width:100%; overflow:hidden;">
                    <ul class="pagination pagination-bounded flex-wrap justify-content-center m-0" style="max-width:100%;">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-pill me-1" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-category="@Model.Category"
                               asp-route-search="@Model.SearchQuery"
                               asp-route-brand="@Model.SelectedBrand"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice"
                               asp-route-inStockOnly="@(Model.InStockOnly ? "true" : null)"
                               asp-route-onSaleOnly="@(Model.OnSaleOnly ? "true" : null)"
                               asp-route-flashDeal="@(Model.FlashDealOnly ? "true" : null)"
                               aria-label="Previous Page"
                               tabindex="@(Model.CurrentPage <= 1 ? -1 : null)"
                               aria-disabled="@(Model.CurrentPage <= 1 ? "true" : null)">
                                <i class="fa-solid fa-chevron-left me-1"></i>Prev
                            </a>
                        </li>
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            bool isMobileVisible = i >= mobileStart && i <= mobileEnd;
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "") @(isMobileVisible ? "" : "d-none d-md-inline-block")">
                                <a class="page-link rounded-pill mx-1" asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-category="@Model.Category"
                                   asp-route-search="@Model.SearchQuery"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-sortBy="@Model.SortBy"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-inStockOnly="@(Model.InStockOnly ? "true" : null)"
                                   asp-route-onSaleOnly="@(Model.OnSaleOnly ? "true" : null)"
                                   asp-route-flashDeal="@(Model.FlashDealOnly ? "true" : null)">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-pill ms-1" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-category="@Model.Category"
                               asp-route-search="@Model.SearchQuery"
                               asp-route-brand="@Model.SelectedBrand"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice"
                               asp-route-inStockOnly="@(Model.InStockOnly ? "true" : null)"
                               asp-route-onSaleOnly="@(Model.OnSaleOnly ? "true" : null)"
                               asp-route-flashDeal="@(Model.FlashDealOnly ? "true" : null)"
                               aria-label="Next Page"
                               tabindex="@(Model.CurrentPage >= Model.TotalPages ? -1 : null)"
                               aria-disabled="@(Model.CurrentPage >= Model.TotalPages ? "true" : null)">
                                Next<i class="fa-solid fa-chevron-right ms-1"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </section>
</div>

<!-- Mobile Offcanvas Filters -->
<div class="offcanvas offcanvas-start rounded-end-4" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel" style="background:var(--bg-surface); color:var(--text-primary);">
    <div class="offcanvas-header border-bottom" style="border-color:var(--border-subtle) !important;">
        <h5 class="offcanvas-title font-heading fw-bold" id="filterOffcanvasLabel">
            <i class="fa-solid fa-sliders me-2 text-primary"></i>Filter Catalog
        </h5>
        <button type="button" class="btn-close btn-close-white-focus" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form asp-controller="Shop" asp-action="Index" method="get">
            <input type="hidden" name="sortBy" value="@Model.SortBy" />
            <input type="hidden" name="search" value="@Model.SearchQuery" />

            <div class="mb-4">
                <label class="form-label small fw-bold text-uppercase" style="color:var(--text-muted);">Departments</label>
                <div class="d-flex flex-column gap-2" style="max-height: 360px; overflow-y: auto;">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="category" value="" id="mCatAll" checked="@(string.IsNullOrEmpty(Model.Category))" />
                        <label class="form-check-label small fw-semibold" for="mCatAll"><i class="fa-solid fa-layer-group me-1.5 text-primary"></i>All Departments</label>
                    </div>
                    @foreach (var dept in Model.Categories.Where(c => c.ParentCategoryId == null).OrderBy(c => c.DisplayOrder))
                    {
                        var isDeptActive = Model.Category == dept.Slug;
                        var mCollapseId = $"m_subcat_col_{dept.Id}";
                        var childSlugs = dept.SubCategories.Select(sc => sc.Slug).ToHashSet();
                        var isChildActive = !string.IsNullOrEmpty(Model.Category) && childSlugs.Contains(Model.Category);
                        var isExpanded = isDeptActive || isChildActive;

                        <div class="dept-box rounded-3 p-1.5" style="background:var(--bg-surface-elevated); border:1px solid var(--border-subtle);">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="form-check mb-0 flex-grow-1 text-truncate">
                                    <input class="form-check-input" type="radio" name="category" value="@dept.Slug" id="mDept_@dept.Id" checked="@isDeptActive" />
                                    <label class="form-check-label small fw-semibold text-truncate @(isDeptActive ? "text-primary" : "")" for="mDept_@dept.Id">
                                        <i class="fa-solid @dept.Icon me-1 text-primary" style="font-size:0.8rem;"></i>
                                        @dept.Name
                                    </label>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge rounded-pill" style="background:var(--bg-secondary); color:var(--text-muted); font-size:0.68rem;">@dept.ProductCount</span>
                                    @if (dept.SubCategories.Any())
                                    {
                                        <a class="btn btn-sm btn-link p-0 text-decoration-none text-muted" data-bs-toggle="collapse" href="#@mCollapseId" role="button" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@mCollapseId">
                                            <i class="fa-solid fa-chevron-down" style="font-size:0.65rem;"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                            @if (dept.SubCategories.Any())
                            {
                                <div class="collapse @(isExpanded ? "show" : "") mt-1 ps-3 pt-1 border-top" id="@mCollapseId" style="border-color:var(--border-subtle) !important;">
                                    @foreach (var sub in dept.SubCategories.OrderBy(s => s.DisplayOrder))
                                    {
                                        var isSubActive = Model.Category == sub.Slug;
                                        <div class="form-check py-0.5 mb-0">
                                            <input class="form-check-input" type="radio" name="category" value="@sub.Slug" id="mSub_@sub.Id" checked="@isSubActive" />
                                            <label class="form-check-label small d-flex justify-content-between align-items-center @(isSubActive ? "fw-bold text-primary" : "text-muted")" for="mSub_@sub.Id" style="font-size:0.75rem;">
                                                <span>@sub.Name</span>
                                                <span class="badge rounded-pill bg-light text-secondary ms-1" style="font-size:0.62rem;">@sub.ProductCount</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (Model.Brands != null && Model.Brands.Any())
            {
                <div class="mb-4">
                    <label class="form-label small fw-bold text-uppercase" style="color:var(--text-muted);">Brands</label>
                    <div class="d-flex flex-column gap-2" style="max-height: 160px; overflow-y: auto;">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="brand" value="" id="mBrandAll" checked="@(string.IsNullOrEmpty(Model.SelectedBrand))" />
                            <label class="form-check-label small fw-semibold" for="mBrandAll">All Brands</label>
                        </div>
                        @foreach (var b in Model.Brands)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="brand" value="@b" id="mBrand_@b.Replace(" ", "_")" checked="@(Model.SelectedBrand == b)" />
                                <label class="form-check-label small" for="mBrand_@b.Replace(" ", "_")">@b</label>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mb-4">
                <label class="form-label small fw-bold text-uppercase" style="color:var(--text-muted);">Price Range (PKR)</label>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Min" value="@Model.MinPrice" />
                    </div>
                    <div class="col-6">
                        <input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Max" value="@Model.MaxPrice" />
                    </div>
                </div>
            </div>

            <div class="mb-4 pt-2 border-top" style="border-color:var(--border-subtle) !important;">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" name="flashDeal" value="true" id="mFlashDealSwitch" checked="@Model.FlashDealOnly" />
                    <label class="form-check-label small fw-semibold" for="mFlashDealSwitch"><i class="fa-solid fa-bolt text-warning me-1"></i>Flash Deals Only</label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" name="inStockOnly" value="true" id="mInStockSwitch" checked="@Model.InStockOnly" />
                    <label class="form-check-label small fw-semibold" for="mInStockSwitch">In Stock Only</label>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="onSaleOnly" value="true" id="mOnSaleSwitch" checked="@Model.OnSaleOnly" />
                    <label class="form-check-label small fw-semibold" for="mOnSaleSwitch">Discounted Deals</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 rounded-pill py-2.5">
                Apply Filters
            </button>
        </form>
    </div>
</div>
