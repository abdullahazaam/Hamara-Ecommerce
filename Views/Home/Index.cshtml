            </a>
        </div>

        <div class="row g-3">
            @foreach (var (product, idx) in beautyPersonalCare.Take(4).Select((p, i) => (p, i)))
            {
                <div class="col-xl-3 col-lg-4 col-sm-6 d-flex flex-column reveal-on-scroll" style="transition-delay: @(idx * 60)ms">
                    @await Html.PartialAsync("_ProductCard", product)
                </div>
            }
        </div>
    </section>
}

<!-- ================================================================
     8. HOME ESSENTIALS
     ================================================================ -->
@if (homeEssentials.Any())
{
    <section class="section-surface mb-5 reveal-on-scroll" aria-labelledby="homeHeading">
        <div class="section-header-row">
            <div>
                <span class="section-eyebrow bg-warning-subtle text-warning border border-warning">Lifestyle &amp; Kitchen</span>
                <h2 id="homeHeading" class="section-title">Home Essentials</h2>
                <p class="section-subtitle">Luxury cotton bed sheets, air fryers, food processors, and cozy home accessories</p>
            </div>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="home-lifestyle" class="btn btn-glass btn-sm rounded-pill px-3">
