                <h2 id="electronicsHeading" class="section-title">Electronics</h2>
                <p class="section-subtitle">PTA-approved smartphones, M-series MacBooks, gaming laptops, and 4K Google Smart TVs</p>
            </div>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="electronic-devices" class="btn btn-primary-custom btn-sm rounded-pill px-3">
                Explore Electronics <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var (product, idx) in electronics.Take(4).Select((p, i) => (p, i)))
            {
                <div class="col-xl-3 col-lg-4 col-sm-6 d-flex flex-column reveal-on-scroll" style="transition-delay: @(idx * 60)ms">
                    @await Html.PartialAsync("_ProductCard", product)
                </div>
            }
        </div>
    </section>
}

<!-- ================================================================
     11. NEW ARRIVALS
     ================================================================ -->
@if (newArrivals.Any())
{
    <section class="section-surface section-surface--arrivals mb-5 reveal-on-scroll" aria-labelledby="arrivalsHeading">
        <div class="section-header-row">
            <div>
                <span class="section-eyebrow bg-success-subtle text-success border border-success">Fresh Releases</span>
                <h2 id="arrivalsHeading" class="section-title">New Arrivals</h2>
                <p class="section-subtitle">The latest models, verified spare parts, and newest lifestyle items</p>
            </div>
            <a asp-controller="Shop" asp-action="Index" asp-route-sortBy="newest" class="btn btn-glass btn-sm rounded-pill px-3">
                View All New <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var (product, idx) in newArrivals.Take(4).Select((p, i) => (p, i)))
            {
                <div class="col-xl-3 col-lg-4 col-sm-6 d-flex flex-column reveal-on-scroll" style="transition-delay: @(idx * 60)ms">
                    @await Html.PartialAsync("_ProductCard", product)
                </div>
            }
        </div>
    </section>
}

<!-- ================================================================
     12. TRUST CTA BANNER
     ================================================================ -->
<section class="reveal-on-scroll mb-2">
    <div class="card-glass p-4 p-md-5 text-center rounded-4 border-0"
         style="background:linear-gradient(135deg,rgba(37,99,235,0.12),rgba(124,58,237,0.08));border:1px solid var(--border-default) !important;">
        <div class="row align-items-center g-4">
            <div class="col-md-8 text-md-start">
                <h2 class="h3 fw-bold mb-2">Discover @publishedCount.ToString("N0") Products on HamaraCommerce</h2>
                <p class="mb-0" style="color:var(--text-muted);font-size:1rem;">
                    From Karachi to Peshawar, browse products across Pakistan with cash on delivery and reliable nationwide shipping.
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-controller="Shop" asp-action="Index" class="btn btn-primary-custom px-5 py-2.5 rounded-pill fs-6">
                    <i class="fa-solid fa-bag-shopping me-2"></i>Shop The Marketplace
                </a>
            </div>
        </div>
    </div>
</section>