@{
    ViewData["Title"] = "HamaraCommerce | Online Store";
    var categories = ViewBag.Categories as List<HamaraCommerce.Models.Category> ?? new();
    var everydayLowPrices = ViewBag.EverydayLowPrices as List<HamaraCommerce.Models.Product> ?? new();
    var budgetDeals = ViewBag.BudgetDeals as List<HamaraCommerce.Models.Product> ?? new();
    var mobileAccessories = ViewBag.MobileAccessories as List<HamaraCommerce.Models.Product> ?? new();
    var beautyPersonalCare = ViewBag.BeautyPersonalCare as List<HamaraCommerce.Models.Product> ?? new();
    var homeEssentials = ViewBag.HomeEssentials as List<HamaraCommerce.Models.Product> ?? new();
    var fashionPicks = ViewBag.FashionPicks as List<HamaraCommerce.Models.Product> ?? new();
    var electronics = ViewBag.Electronics as List<HamaraCommerce.Models.Product> ?? new();
    var newArrivals = ViewBag.NewArrivals as List<HamaraCommerce.Models.Product> ?? new();
    var heroProduct = ViewBag.HeroProduct as HamaraCommerce.Models.Product ?? everydayLowPrices.FirstOrDefault();

    string heroImg = !string.IsNullOrEmpty(heroProduct?.MainImage) 
        ? heroProduct.MainImage 
        : "/images/hero-showcase.webp";
    string heroTitle = heroProduct?.Title ?? "Anker 511 GaN Fast Charger";
    decimal heroPrice = heroProduct?.Price ?? 4799;
    string heroSlug = heroProduct?.Slug ?? heroProduct?.Id.ToString() ?? "";
    int publishedCount = ViewBag.PublishedProductCount ?? 163;
    int categoryCount = ViewBag.TotalCategoriesCount ?? (categories.Count > 0 ? categories.Count : 12);
}

<!-- ================================================================
     1. HIGH-IMPACT 3D HERO SECTION
     ================================================================ -->
<section class="hero-section reveal-on-scroll" aria-labelledby="heroHeading">
    <div class="row align-items-center g-4 g-lg-5 position-relative" style="z-index:2;">
        <!-- Left: Headline & CTAs -->
        <div class="col-lg-6" style="min-width:0;">
            <div class="hero-trust-badge">
                <span>🇵🇰</span>
                Online Shopping in Pakistan
            </div>

            <h1 id="heroHeading" class="hero-heading">
                Shop Everything You Love at<br>
                <span class="text-sapphire">HamaraCommerce</span>
            </h1>

            <p class="hero-lead">
                Browse @publishedCount.ToString("N0") products across @categoryCount major departments with transparent stock and nationwide cash on delivery.
            </p>

            <div class="d-flex flex-wrap gap-3 mb-4">
                <a asp-controller="Shop" asp-action="Index"
                   class="btn btn-primary-custom px-4 py-2.5 rounded-pill shadow-sm">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span>Explore All Departments</span>
                    <i class="fa-solid fa-arrow-right cta-arrow ms-1"></i>
                </a>
                <a asp-controller="Shop" asp-action="Index" asp-route-sortBy="recommended"
                   class="btn btn-hero-secondary px-4 py-2.5 rounded-pill">
                    <i class="fa-solid fa-thumbs-up text-primary me-1"></i>
                    <span>Recommended Picks</span>
                </a>
            </div>

            <!-- Trust micro-stats -->
            <div class="d-flex flex-wrap gap-3">
                <div class="hero-stat-badge">
                    <div class="hero-stat-num hero-stat-num--blue">@publishedCount.ToString("N0")</div>
                    <div class="hero-stat-label">Published<br>Products</div>
                </div>
                <div class="hero-stat-badge">
                    <div class="hero-stat-num hero-stat-num--green">@categoryCount</div>
                    <div class="hero-stat-label">Major<br>Departments</div>
                </div>
                <div class="hero-stat-badge d-none d-sm-inline-flex">
                    <div class="hero-stat-num hero-stat-num--gold">PKR</div>
                    <div class="hero-stat-label">Real Local<br>Pricing</div>
                </div>
            </div>
        </div>

        <!-- Right: Hero Product Showcase -->
        <div class="col-lg-6">
            <div class="hero-3d-stage" data-tilt="hero">
                <!-- Glare overlay -->
                <div class="tilt-glare" aria-hidden="true"></div>

                <!-- Decorative concentric rotating rings -->
                <div class="hero-rings hero-rings--outer" aria-hidden="true"></div>
                <div class="hero-rings hero-rings--inner" aria-hidden="true"></div>

                <!-- Spotlight glow -->
                <div class="hero-spotlight" aria-hidden="true"></div>

                <!-- Floating commerce particle icons -->
                <div class="hero-particle hero-particle--1" aria-hidden="true" data-tilt-z="badge">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div class="hero-particle hero-particle--2" aria-hidden="true" data-tilt-z="badge">
                    <i class="fa-solid fa-sparkles"></i>
                </div>

                <!-- 3D Composition with Image & Badges -->
                <div class="hero-3d-composition">
                    <!-- Main Product Image Stage -->
                    <a href="@(!string.IsNullOrEmpty(heroSlug) ? $"/Shop/Details/{heroSlug}" : "/Shop")" class="hero-img-container text-decoration-none" data-tilt-z="stage">
                        <img src="@heroImg"
                             alt="@heroTitle"
                             class="hero-img-main rounded-4"
                             width="320"
                             height="320"
                             fetchpriority="high"
                             decoding="async"
                             onerror="this.onerror=null;this.src='/images/hero-showcase.webp';" />
                    </a>

                    <!-- Soft Floor Shadow -->
                    <div class="hero-floor-shadow" aria-hidden="true"></div>

                    <!-- Floating Glass Badges -->
                    <div class="hero-floating-badge hero-badge--price" data-tilt-z="badge">
                        <div class="text-xs text-uppercase fw-bold badge-subtitle-blue">Recommended Deal</div>
                        <div class="fw-extrabold font-heading hero-badge-value">Rs. @heroPrice.ToString("N0")</div>
                    </div>

                    <div class="hero-floating-badge hero-badge--delivery" data-tilt-z="badge">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-truck-fast text-primary"></i>
                            <div>
                                <div class="text-xs text-uppercase fw-bold badge-subtitle-green">Nationwide Delivery</div>
                                <div class="text-xs hero-badge-muted">Karachi, Lahore, Islamabad &amp; More</div>
                            </div>
                        </div>
                    </div>

                    <div class="hero-floating-badge hero-badge--rating" data-tilt-z="badge">
                        <i class="fa-solid fa-certificate text-primary"></i>
                        <span class="fw-bold hero-badge-value">100%</span>
                        <span class="text-xs hero-badge-muted">Curated Items</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================================================================
     2. TRUST & VALUE PROPOSITION CARDS
     ================================================================ -->
<section class="row g-3 mb-5" aria-label="Shopping guarantees">
    <div class="col-md-3 col-6 reveal-on-scroll reveal-delay-1">
        <div class="value-prop-card value-prop-card--shipping glass-card p-3" data-tilt="subtle">
            <div class="value-prop-icon" aria-hidden="true">
                <i class="fa-solid fa-truck-fast"></i>
            </div>
            <h2 class="fs-6 fw-bold mb-1">Nationwide Delivery</h2>
            <p class="text-xs mb-0" style="color:var(--text-muted);">Express tracked shipping across Pakistan</p>
        </div>
    </div>
    <div class="col-md-3 col-6 reveal-on-scroll reveal-delay-2">
        <div class="value-prop-card value-prop-card--cod glass-card p-3" data-tilt="subtle">
            <div class="value-prop-icon" aria-hidden="true">
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>
            <h2 class="fs-6 fw-bold mb-1">Cash on Delivery</h2>
            <p class="text-xs mb-0" style="color:var(--text-muted);">Pay comfortably upon physical parcel arrival</p>
        </div>
    </div>
    <div class="col-md-3 col-6 reveal-on-scroll reveal-delay-3">
        <div class="value-prop-card value-prop-card--returns glass-card p-3" data-tilt="subtle">
            <div class="value-prop-icon" aria-hidden="true">
                <i class="fa-solid fa-arrows-rotate"></i>
            </div>
            <h2 class="fs-6 fw-bold mb-1">7-Day Easy Returns</h2>
            <p class="text-xs mb-0" style="color:var(--text-muted);">Simple claim process for defect protection</p>
        </div>
    </div>
    <div class="col-md-3 col-6 reveal-on-scroll reveal-delay-4">
        <div class="value-prop-card value-prop-card--support glass-card p-3" data-tilt="subtle">
            <div class="value-prop-icon" aria-hidden="true">
                <i class="fa-solid fa-headset"></i>
            </div>
            <h2 class="fs-6 fw-bold mb-1">Direct Support</h2>
            <p class="text-xs mb-0" style="color:var(--text-muted);">Dedicated assistance for your orders</p>
        </div>
    </div>
</section>

<!-- ================================================================
     3. POPULAR CATEGORIES (12 Major Marketplace Departments)
     ================================================================ -->
@if (categories.Any())
{
    <section class="mb-5 reveal-on-scroll" aria-labelledby="departmentsHeading">
        <div class="section-header-row">
            <div>
                <span class="section-eyebrow bg-primary-subtle text-primary border border-primary">Marketplace Categories</span>
                <h2 id="departmentsHeading" class="section-title">Popular Categories</h2>
                <p class="section-subtitle">Explore @categoryCount flagship departments covering tech, fashion, essentials, and home</p>
            </div>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-glass btn-sm rounded-pill px-3">
                View All Departments <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var (dept, idx) in categories.Select((c, i) => (c, i)))
            {
                <div class="col-xl-2 col-lg-3 col-md-4 col-6 reveal-on-scroll" style="transition-delay: @(idx * 40)ms">
                    <a asp-controller="Shop" asp-action="Index" asp-route-category="@dept.Slug"
                       class="category-card glass-card text-decoration-none d-flex flex-column align-items-center justify-content-center p-3 rounded-4 h-100 text-center"
                       data-tilt="subtle" style="border: 1px solid var(--border-subtle); background: var(--bg-surface-elevated);">
                        <div class="category-card-icon mb-2 d-flex align-items-center justify-content-center rounded-circle"
                             style="width: 50px; height: 50px; background: var(--bg-surface); color: var(--brand-primary); font-size: 1.25rem;">
                            <i class="fa-solid @dept.Icon"></i>
                        </div>
                        <span class="category-card-name fw-bold small mb-1" style="color: var(--text-primary); font-size: 0.85rem;">@dept.Name</span>
                        <span class="badge rounded-pill" style="background: var(--bg-secondary); color: var(--text-muted); font-size: 0.7rem;">@dept.ProductCount items</span>
                    </a>
                </div>
            }
        </div>
    </section>
}

<!-- ================================================================
     4. EVERYDAY LOW PRICES (< PKR 3,500)
     ================================================================ -->
@if (everydayLowPrices.Any())
{
    <section class="section-surface mb-5 reveal-on-scroll" aria-labelledby="everydayHeading">
        <div class="section-header-row">
            <div>
                <span class="section-eyebrow bg-success-subtle text-success border border-success">Pantry &amp; Daily Staples</span>
                <h2 id="everydayHeading" class="section-title">Everyday Low Prices</h2>
                <p class="section-subtitle">Essential grocery packs, tea blends, spices, and household must-haves under Rs. 3,500</p>
            </div>
            <a asp-controller="Shop" asp-action="Index" asp-route-maxPrice="3500" class="btn btn-glass btn-sm rounded-pill px-3">
                See More Low Prices <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var (product, idx) in everydayLowPrices.Take(4).Select((p, i) => (p, i)))
            {
                <div class="col-xl-3 col-lg-4 col-sm-6 d-flex flex-column reveal-on-scroll" style="transition-delay: @(idx * 60)ms">
                    @await Html.PartialAsync("_ProductCard", product)
                </div>
            }
        </div>
    </section>
}

<!-- ================================================================
     5. BUDGET DEALS
     ================================================================ -->
@if (budgetDeals.Any())
{
    <section class="section-surface section-surface--flash mb-5 reveal-on-scroll" aria-labelledby="budgetHeading">
        <div class="section-header-row">
            <div>
                <span class="badge-tag badge-flash mb-2 d-inline-block"><i class="fa-solid fa-tags"></i>Smart Savings</span>
                <h2 id="budgetHeading" class="section-title">Budget Deals</h2>
                <p class="section-subtitle">Verified discounts and price cuts across popular Pakistani brands</p>
            </div>
            <a asp-controller="Shop" asp-action="Index" asp-route-sortBy="discount" class="btn btn-danger-custom btn-sm rounded-pill px-3">
                Explore All Deals <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var (product, idx) in budgetDeals.Take(4).Select((p, i) => (p, i)))
            {
                <div class="col-xl-3 col-lg-4 col-sm-6 d-flex flex-column reveal-on-scroll" style="transition-delay: @(idx * 60)ms">
                    @await Html.PartialAsync("_ProductCard", product)
                </div>
            }
        </div>
    </section>
}

<!-- ================================================================
     6. HEADPHONES & AUDIO
     ================================================================ -->
@if (mobileAccessories.Any())
{
    <section class="section-surface mb-5 reveal-on-scroll" aria-labelledby="audioHeading">
        <div class="section-header-row">
            <div>
                <span class="section-eyebrow bg-primary-subtle text-primary border border-primary">High-Fidelity Sound</span>
                <h2 id="audioHeading" class="section-title">Headphones &amp; Audio</h2>
                <p class="section-subtitle">Active noise-cancelling headphones, wireless earbuds, and portable soundbars</p>
            </div>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="headphones-audio" class="btn btn-glass btn-sm rounded-pill px-3">
                All Audio <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var (product, idx) in mobileAccessories.Take(4).Select((p, i) => (p, i)))
            {
                <div class="col-xl-3 col-lg-4 col-sm-6 d-flex flex-column reveal-on-scroll" style="transition-delay: @(idx * 60)ms">
                    @await Html.PartialAsync("_ProductCard", product)
                </div>
            }
        </div>
    </section>
}

<!-- ================================================================
     7. BEAUTY & PERSONAL CARE
     ================================================================ -->
@if (beautyPersonalCare.Any())
{
    <section class="section-surface mb-5 reveal-on-scroll" aria-labelledby="beautyHeading">
        <div class="section-header-row">
            <div>
                <span class="section-eyebrow bg-info-subtle text-info border border-info">Skincare &amp; Wellness</span>
                <h2 id="beautyHeading" class="section-title">Beauty &amp; Personal Care</h2>
                <p class="section-subtitle">Dermatologist-tested skincare, herbal remedies, body mists, and authentic fragrances</p>
            </div>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="health-beauty" class="btn btn-glass btn-sm rounded-pill px-3">
