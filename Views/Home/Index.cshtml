                    @await Html.PartialAsync("_ProductCard", product)
                </div>
            }
        </div>
    </section>
}

<!-- ================================================================
     9. GAMING & SMART WEARABLES
     ================================================================ -->
@if (fashionPicks.Any())
{
    <section class="section-surface mb-5 reveal-on-scroll" aria-labelledby="gamingHeading">
        <div class="section-header-row">
            <div>
                <span class="section-eyebrow bg-danger-subtle text-danger border border-danger">Play &amp; Wearables</span>
                <h2 id="gamingHeading" class="section-title">Gaming &amp; Smart Wearables</h2>
                <p class="section-subtitle">Next-generation consoles, pro controllers, mechanical keyboards, and smart fitness watches</p>
            </div>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="gaming" class="btn btn-glass btn-sm rounded-pill px-3">
                View All Gaming <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var (product, idx) in fashionPicks.Take(4).Select((p, i) => (p, i)))
            {
                <div class="col-xl-3 col-lg-4 col-sm-6 d-flex flex-column reveal-on-scroll" style="transition-delay: @(idx * 60)ms">
                    @await Html.PartialAsync("_ProductCard", product)
