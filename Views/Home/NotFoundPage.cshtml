@{
    int statusCode = ViewBag.StatusCode != null ? (int)ViewBag.StatusCode : 404;
    ViewData["Title"] = statusCode == 404 ? "Page Not Found (404) — Hamara Commerce" : $"Error ({statusCode}) — Hamara Commerce";
}

<div class="row justify-content-center py-5 reveal-on-scroll">
    <div class="col-md-7 col-lg-6 text-center">
        <div class="card-glass rounded-4 p-4 p-md-5 position-relative overflow-hidden"
             style="background:var(--bg-glass); backdrop-filter:blur(24px); border:1px solid var(--border-default) !important; box-shadow:var(--shadow-xl);">
            
            <div class="display-1 font-heading fw-bold mb-2" 
                 style="background: linear-gradient(135deg, #2563eb 0%, #7c3aed 50%, #06b6d4 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 4px 16px rgba(37,99,235,0.3));">
                @statusCode
            </div>

            <h1 class="h3 font-heading fw-bold mb-3" style="color:var(--text-primary); letter-spacing:-0.02em;">
                @(statusCode == 404 ? "Oops! We can't find that page" : "An Unexpected Server Error Occurred")
            </h1>

            <p class="small mb-4 mx-auto" style="max-width: 440px; color:var(--text-muted); line-height:1.7;">
                @(statusCode == 404 
                    ? "The link you followed may be expired, or the product may have been moved. Try exploring our collection or searching for what you need."
                    : "Our technical operations team has been notified. Please try refreshing or return to the main catalog.")
            </p>

            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom rounded-pill px-4">
                    <i class="fa-solid fa-house me-1"></i>Back to Home
                </a>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-glass rounded-pill px-4">
                    <i class="fa-solid fa-bag-shopping me-1"></i>Browse Products
                </a>
            </div>
        </div>
    </div>
</div>
