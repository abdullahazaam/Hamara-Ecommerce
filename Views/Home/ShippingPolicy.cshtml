@{
    ViewData["Title"] = "Shipping and Delivery Policy";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-card mb-4">
            <h1 class="h3 font-heading fw-bold text-dark mb-3">Shipping & Delivery Policy</h1>
            <p class="text-muted small mb-4">Last Updated: September 2026</p>

            <div class="text-secondary small d-flex flex-column gap-3" style="line-height: 1.8;">
                <h2 class="h5 font-heading fw-bold text-dark mb-1">1. Delivery Timeframes & Coverage</h2>
                <p class="mb-0">
                    We deliver across all major cities and rural postal districts across Pakistan via courier partners (TCS, Leopard, Call Courier, M&P, Trax).
                </p>
                <ul>
                    <li><strong>Major Metros (Lahore, Karachi, Islamabad, Rawalpindi):</strong> 1 to 2 business days.</li>
                    <li><strong>Other Cities (Faisalabad, Multan, Peshawar, Quetta, Sialkot, etc.):</strong> 2 to 3 business days.</li>
                    <li><strong>Remote / District Areas:</strong> 3 to 5 business days.</li>
                </ul>

                <h2 class="h5 font-heading fw-bold text-dark mb-1">2. Shipping Rates & Free Shipping</h2>
                <p class="mb-0">
                    Standard Ground Shipping is standard flat rate across Pakistan. Orders with a subtotal of <strong>Rs. 5,000 or more</strong> qualify for <strong>100% Free Shipping</strong>. Express air courier options are selectable during checkout at calculated rates.
                </p>

                <h2 class="h5 font-heading fw-bold text-dark mb-1">3. Real-Time Tracking</h2>
                <p class="mb-0">
                    As soon as your package is dispatched from our fulfillment center, you will receive an SMS and email containing your official Tracking Reference (e.g. <code>TRK-XXXXXXXX</code>) which can be tracked live on our <a asp-controller="OrderTracking" asp-action="Index">Order Tracking Portal</a>.
                </p>

                <h2 class="h5 font-heading fw-bold text-dark mb-1">4. Delivery Inspection & Damaged Shipments</h2>
                <p class="mb-0">
                    If the outer packaging appears visibly crushed or tampered with upon delivery, please document the condition with the courier agent and notify our support hotline immediately at <code>support@hamaracommerce.pk</code>.
                </p>
            </div>
        </div>
    </div>
</div>
