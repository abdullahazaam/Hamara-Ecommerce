@{
    ViewData["Title"] = "Privacy & Data Protection Policy";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-card mb-4">
            <h1 class="h3 font-heading fw-bold text-dark mb-3">Privacy & Data Protection Policy</h1>
            <p class="text-muted small mb-4">Last Updated: September 2026</p>

            <div class="text-secondary small d-flex flex-column gap-3" style="line-height: 1.8;">
                <h2 class="h5 font-heading fw-bold text-dark mb-1">1. Information We Collect</h2>
                <p class="mb-0">
                    When you create an account, place an order, or browse Hamara Commerce, we collect essential operational data including your name, email address, delivery phone number, and physical postal address required solely for fulfillment, courier logistics, and order status communications.
                </p>

                <h2 class="h5 font-heading fw-bold text-dark mb-1">2. Payment & Financial Data Security</h2>
                <p class="mb-0">
                    Hamara Commerce never stores raw payment card numbers, CVVs, or bank security PINs in plain text. All online debit/credit card transactions are handled exclusively through PCI-DSS Level 1 compliant gateway partners with bank-grade 256-bit SSL encryption.
                </p>

                <h2 class="h5 font-heading fw-bold text-dark mb-1">3. Non-Disclosure & Third-Party Sharing</h2>
                <p class="mb-0">
                    We strictly do not sell, rent, or trade your personal information to third-party marketing companies. Delivery information is disclosed exclusively to authorized nationwide courier partners solely to execute door-to-door ground shipment.
                </p>

                <h2 class="h5 font-heading fw-bold text-dark mb-1">4. Customer Rights & Account Deletion</h2>
                <p class="mb-0">
                    You maintain complete control over your saved addresses, password credentials, and order history. To request account deletion or data portability, please contact our support desk at <code>privacy@hamaracommerce.pk</code>.
                </p>
            </div>
        </div>
    </div>
</div>
