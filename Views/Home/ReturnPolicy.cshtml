@{
    ViewData["Title"] = "Return and Refund Policy";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-card mb-4">
            <h1 class="h3 font-heading fw-bold text-dark mb-3">30-Day Return & Refund Policy</h1>
            <p class="text-muted small mb-4">Last Updated: September 2026</p>

            <div class="text-secondary small d-flex flex-column gap-3" style="line-height: 1.8;">
                <h2 class="h5 font-heading fw-bold text-dark mb-1">1. 30-Day Money-Back Guarantee</h2>
                <p class="mb-0">
                    We stand firmly behind the authenticity and quality of every product sold on Hamara Commerce. If your purchase arrives defective, damaged, incorrect, or materially different from description, you are eligible for a replacement or full refund within <strong>30 days of delivery</strong>.
                </p>

                <h2 class="h5 font-heading fw-bold text-dark mb-1">2. Conditions for Return</h2>
                <ul>
                    <li>Item must be in its original packaging with all included accessories, documentation, and warranty seals intact.</li>
                    <li>For hygiene and safety reasons, certain personal care, opened consumables, or software licenses cannot be returned once unsealed unless defective.</li>
                </ul>

                <h2 class="h5 font-heading fw-bold text-dark mb-1">3. How to Initiate a Return</h2>
                <p class="mb-0">
                    Log in to your <a asp-controller="Account" asp-action="Orders">Customer Orders Portal</a>, select the delivered order, and click "Request Return", or contact our customer desk at <code>returns@hamaracommerce.pk</code>. Our logistics team will arrange reverse-courier pickup from your address.
                </p>

                <h2 class="h5 font-heading fw-bold text-dark mb-1">4. Refund Processing Time</h2>
                <p class="mb-0">
                    Once returned items are inspected at our fulfillment facility (typically within 48 hours of receipt), refunds are issued via your original payment method, direct bank transfer (Raast/IBAN), or store credit vouchers.
                </p>
            </div>
        </div>
    </div>
</div>
